# Copy to /etc/agentctl.env, then: sudo chown ubuntu:ubuntu /etc/agentctl.env && sudo chmod 600 /etc/agentctl.env
# Secrets only. Everything non-secret belongs in agentctl/backends.toml.

# Anthropic — serves both the opus and fable backends from one key.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Local llama-server. Same value as LLAMA_API_KEY in /etc/llm-api.env.
# That file is root-owned 600, so the wrapper cannot read it and needs its own copy.
LLAMA_API_KEY=sk-local-REPLACE_ME

# TypeSafe Jev. Leave empty until the key exists; jev stays disabled in backends.toml.
TYPESAFE_API_KEY=

# Sakana Fugu. No key available -- fugu stays disabled. Uncomment when one exists.
#SAKANA_API_KEY=
