From f48049e70607f48bd8c04b47ebe2c25666bd73ba Mon Sep 17 00:00:00 2001
From: akarokaneko <akarokaneko@gmail.com>
Date: Mon, 21 Sep 2026 00:07:27 +0000
Subject: [PATCH] vulkan: use f32 accumulation for quant matmul on GCN

GCN has no matrix cores, and the scalar f16 accumulators in mul_mm are not
packed by the compiler, so f16 accumulation adds conversions without any
rate gain.

Measured on gfx906 (Radeon VII, RADV), Qwen3.8-27B UD-Q4_K_S, 933 token
prompt: prompt processing 132.9 -> 173.2 t/s (+30%), token generation
unchanged at 26.3 t/s. Per type, only the quant types that cannot take the
Q8_1 path change: iq4_xs -30.4%, iq3_xxs -31.5%, iq4_nl -30.9%, while q4_K
and q5_K stay within 1%.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 ggml/src/ggml-vulkan/ggml-vulkan.cpp | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/ggml/src/ggml-vulkan/ggml-vulkan.cpp b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
index da0e24f..2815389 100644
--- a/ggml/src/ggml-vulkan/ggml-vulkan.cpp
+++ b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
@@ -5699,6 +5699,13 @@ static bool ggml_vk_get_mul_mat_mat_f16acc(ggml_backend_vk_context * ctx, ggml_t
     if (ctx->device->coopmat_support) {
         return ctx->device->fp16 && ctx->device->coopmat_acc_f16_support && prec == GGML_PREC_DEFAULT;
     }
+    // GCN has no matrix cores and the compiler does not pack the scalar f16
+    // accumulators, so f16 acc adds conversions without a rate gain.
+    // Measured on gfx906: f32 acc is ~28% faster for the quant types that
+    // cannot use the Q8_1 path.
+    if (ctx->device->architecture == vk_device_architecture::AMD_GCN) {
+        return false;
+    }
     return ctx->device->fp16 && prec == GGML_PREC_DEFAULT;
 }
 
