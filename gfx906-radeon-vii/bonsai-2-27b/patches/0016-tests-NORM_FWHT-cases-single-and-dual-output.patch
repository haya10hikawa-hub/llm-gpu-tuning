From 8a3a94c1b626e23695c2763703da882020c38b2e Mon Sep 17 00:00:00 2001
From: bench <bench@local>
Date: Fri, 25 Sep 2026 10:10:39 +0000
Subject: [PATCH 16/34] tests: NORM_FWHT cases (single and dual output)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tests/test-backend-ops.cpp | 46 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 46 insertions(+)

diff --git a/tests/test-backend-ops.cpp b/tests/test-backend-ops.cpp
index 922673c..0aaa863 100644
--- a/tests/test-backend-ops.cpp
+++ b/tests/test-backend-ops.cpp
@@ -4751,6 +4751,46 @@ struct test_fwht_signed : public test_case {
     }
 };
 
+// rms_norm + weight + sign flip + reshape + FWHT-hint matmul, the fusable input transform of a Hadamard-folded
+// mat-vec; with dual the weighted norm is also consumed elsewhere (as the GDN alpha/beta mat-vecs do)
+struct test_norm_fwht : public test_fwht_signed {
+    const bool dual;
+
+    test_norm_fwht(int64_t blk = 1024, int64_t width = 5120, int64_t n_tokens = 1, bool dual = false)
+        : test_fwht_signed(blk, width, n_tokens, GGML_TYPE_F32), dual(dual) {}
+
+    std::string vars() override {
+        return VARS_TO_STR4(blk, width, n_tokens, dual);
+    }
+
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return "NORM_FWHT";
+    }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * a = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, blk, blk);
+        ggml_set_name(a, "a");
+        ggml_tensor * x = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, width, n_tokens);
+        ggml_set_name(x, "x");
+        ggml_tensor * w = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, width);
+        ggml_set_name(w, "w");
+        ggml_tensor * s = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, width);
+        ggml_set_name(s, "s");
+
+        ggml_tensor * nw = ggml_mul(ctx, ggml_rms_norm(ctx, x, 1e-6f), w);
+        ggml_tensor * cur = ggml_mul(ctx, nw, s);
+        cur = ggml_reshape_2d(ctx, cur, blk, width / blk * n_tokens);
+        ggml_tensor * out = ggml_mul_mat(ctx, a, cur);
+        ggml_mul_mat_set_hint(out, GGML_HINT_SRC0_IS_HADAMARD);
+        if (dual) {
+            out = ggml_add(ctx, ggml_reshape_2d(ctx, out, width, n_tokens), nw);
+        }
+        ggml_set_name(out, "out");
+        return out;
+    }
+};
+
 static void init_mul_mat_id_tensors(ggml_context * ctx, int n_mats) {
     std::random_device rd;
     std::default_random_engine rng(rd());
@@ -9255,6 +9295,12 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_eval() {
     test_cases.emplace_back(new test_mul_mat_hadamard(GGML_TYPE_F32, GGML_TYPE_F16, 128, 32, 128));
     test_cases.emplace_back(new test_mul_mat_hadamard(GGML_TYPE_F32, GGML_TYPE_F16, 2048, 1, 2048));
     test_cases.emplace_back(new test_fwht_signed(1024, 5120, 1));
+    for (bool dual : {false, true}) {
+        for (int64_t nt : {1, 3}) {
+            test_cases.emplace_back(new test_norm_fwht(1024, 5120, nt, dual));
+            test_cases.emplace_back(new test_norm_fwht(1024, 17408, nt, dual));
+        }
+    }
     test_cases.emplace_back(new test_fwht_signed(1024, 5120, 32));
     test_cases.emplace_back(new test_fwht_signed(1024, 6144, 7, GGML_TYPE_F16));
     test_cases.emplace_back(new test_fwht_signed(1024, 17408, 3));
