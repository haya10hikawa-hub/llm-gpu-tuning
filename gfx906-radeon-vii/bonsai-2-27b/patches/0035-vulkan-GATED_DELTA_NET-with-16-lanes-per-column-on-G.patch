From 75da608d4a900bd67634dd65dca9e1c9b0dba1bd Mon Sep 17 00:00:00 2001
From: bench <bench@local>
Date: Sat, 26 Sep 2026 14:24:42 +0000
Subject: [PATCH 35/36] vulkan: GATED_DELTA_NET with 16 lanes per column on GCN
 (decode -10%); tests: Bonsai GDN decode perf case

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 ggml/src/ggml-vulkan/ggml-vulkan.cpp | 6 +++++-
 tests/test-backend-ops.cpp           | 2 ++
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-vulkan/ggml-vulkan.cpp b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
index 26ec327..a80fd92 100644
--- a/ggml/src/ggml-vulkan/ggml-vulkan.cpp
+++ b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
@@ -6113,7 +6113,11 @@ static void ggml_vk_load_shaders(vk_device& device, vk_pipeline requested) {
 
             uint32_t lanes_per_column;
             if (S_V >= 128u && device->subgroup_clustered) {
-                lanes_per_column = 8u;
+                // GCN (wave64): 16 lanes per column reads each column in 64-byte runs; GDN decode -10% (Bonsai 2 27B)
+                lanes_per_column = (device->architecture == AMD_GCN && device->subgroup_size == 64) ? 16u : 8u;
+                if (const char * e = getenv("GGML_VK_GDN_LANES")) {
+                    lanes_per_column = (uint32_t)atoi(e);
+                }
             } else {
                 // Use largest power-of-two that divides both S_V and subgroup_size so that
                 // (1) S_V % lanes_per_column == 0 and (2) S_V % (subgroup_size / lanes_per_column) == 0.
diff --git a/tests/test-backend-ops.cpp b/tests/test-backend-ops.cpp
index aac85b9..9bbf934 100644
--- a/tests/test-backend-ops.cpp
+++ b/tests/test-backend-ops.cpp
@@ -10695,6 +10695,8 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_eval() {
 static std::vector<std::unique_ptr<test_case>> make_test_cases_perf() {
     std::vector<std::unique_ptr<test_case>> test_cases;
 
+    // gated delta net of Bonsai 2 27B at decode: 16 k heads, 48 v heads, head 128, one token
+    test_cases.emplace_back(new test_gated_delta_net(GGML_TYPE_F32, 16, 128, 1, 1, 3));
     // GDN alpha / beta projections of Bonsai 2 27B at decode: bf16, 48 rows (96 if merged)
     for (int64_t m : {48, 96}) {
         test_cases.emplace_back(new test_mul_mat(GGML_TYPE_BF16, GGML_TYPE_F32, m, 1, 5120, {1, 1}, {1, 1}));
-- 
