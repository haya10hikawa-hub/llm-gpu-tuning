+// swiglu(gate, up) + sign flip + FWHT, the FFN down-projection input transform, optionally followed by the PQ2_0
+// mat-vec (the q8_1 epilogue)
+struct test_glu_fwht : public test_fwht_signed {
+    const bool mmvq;
+
+    test_glu_fwht(int64_t width = 17408, int64_t n_tokens = 1, bool mmvq = false)
+        : test_fwht_signed(1024, width, n_tokens, GGML_TYPE_F32), mmvq(mmvq) {}
+
+    std::string vars() override {
+        return VARS_TO_STR3(width, n_tokens, mmvq);
+    }
+
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return "GLU_FWHT";
+    }
+
+    double max_nmse_err() override {
+        return mmvq ? 5e-4 : 1e-7;
+    }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * a = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, blk, blk);
+        ggml_set_name(a, "a");
+        ggml_tensor * g = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, width, n_tokens);
+        ggml_set_name(g, "g");
+        ggml_tensor * u = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, width, n_tokens);
+        ggml_set_name(u, "u");
+        ggml_tensor * s = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, width);
+        ggml_set_name(s, "s");
+
+        ggml_tensor * cur = ggml_mul(ctx, ggml_swiglu_split(ctx, g, u), s);
+        cur = ggml_reshape_2d(ctx, cur, blk, width / blk * n_tokens);
+        ggml_tensor * out = ggml_mul_mat(ctx, a, cur);
+        ggml_mul_mat_set_hint(out, GGML_HINT_SRC0_IS_HADAMARD);
+        if (mmvq) {
+            ggml_tensor * w = ggml_new_tensor_2d(ctx, GGML_TYPE_PQ2_0, width, 256);
+            ggml_set_name(w, "w");
+            out = ggml_mul_mat(ctx, w, ggml_reshape_2d(ctx, out, width, n_tokens));
+        }
+        ggml_set_name(out, "out");
+        return out;
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        test_fwht_signed::initialize_tensors(ctx);
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != NULL; t = ggml_get_next_tensor(ctx, t)) {
+            if (t->type == GGML_TYPE_PQ2_0) {
+                init_tensor_uniform(t);
+            }
+        }
+    }
+};
