+// {GLU swiglu(gate, up) split, then the MUL_FWHT chain on its output} -> one fwht_row_glu dispatch
+static bool ggml_vk_can_fuse_glu_fwht(const ggml_backend_vk_context * ctx, const struct ggml_cgraph * cgraph, int node_idx) {
+    static const bool disabled = getenv("GGML_VK_DISABLE_GLU_FWHT") != nullptr;
+    if (disabled || node_idx + 3 >= cgraph->n_nodes) {
+        return false;
+    }
+    const ggml_tensor * glu = cgraph->nodes[node_idx];
+    if (glu->op != GGML_OP_GLU || ggml_get_glu_op(glu) != GGML_GLU_OP_SWIGLU || glu->src[1] == nullptr ||
+        cgraph->nodes[node_idx + 1]->src[0] != glu || !ggml_vk_can_fuse_mul_fwht(ctx, cgraph, node_idx + 1)) {
+        return false;
+    }
+    if (ggml_node_get_use_count(cgraph, node_idx) != 1 || (glu->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+        return false;
+    }
+    const ggml_tensor * g = glu->src[0];
+    const ggml_tensor * u = glu->src[1];
+    const int idx = ggml_vk_fwht_pipeline_idx(cgraph->nodes[node_idx + 3]->src[0]->ne[0]);
+    return g->type == GGML_TYPE_F32 && u->type == GGML_TYPE_F32 && glu->type == GGML_TYPE_F32 &&
+           ggml_is_contiguous(g) && ggml_is_contiguous(u) && ggml_are_same_shape(g, u) && ggml_are_same_shape(g, glu) &&
+           idx >= 0 && ctx->device->pipeline_fwht_row_glu_f32[idx] != nullptr;
+}
