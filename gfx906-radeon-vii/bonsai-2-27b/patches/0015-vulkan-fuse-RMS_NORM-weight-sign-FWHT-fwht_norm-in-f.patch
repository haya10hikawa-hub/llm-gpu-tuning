diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/fwht_norm.comp b/ggml/src/ggml-vulkan/vulkan-shaders/fwht_norm.comp
new file mode 100644
index 0000000..f8ab0e2
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/fwht_norm.comp
@@ -0,0 +1,121 @@
+#version 450
+
+// RMS_NORM + MUL(weight) + MUL(signs) + FWHT in one dispatch: the input transform in front of the
+// Hadamard-folded weight mat-vecs (attn_norm, post-attention norm, output norm).
+//
+// One workgroup per (row, N-sized block). Every workgroup reduces sum(x^2) over the whole row itself - the row
+// is a few tens of KB and L2-resident, so the duplicated reduction is cheap - and then normalises, weights,
+// sign-flips and transforms only its own block, so the blocks of a row run in parallel instead of behind a
+// single-workgroup norm. With HAS_NORM_OUT the normalised, weighted row (the MUL output) is also written for
+// other consumers (the GDN alpha/beta mat-vecs read it unrotated).
+
+#extension GL_EXT_control_flow_attributes : require
+#extension GL_KHR_shader_subgroup_basic : require
+#extension GL_KHR_shader_subgroup_arithmetic : require
+#extension GL_KHR_shader_subgroup_shuffle : require
+
+layout(constant_id = 0) const uint N = 1024;
+
+#define WG 256
+const uint EL = N / WG;
+
+layout(local_size_x = WG, local_size_y = 1, local_size_z = 1) in;
+
+layout(push_constant) uniform parameter
+{
+    uint n_rows;
+    uint row_width;      // elements per row (W), a multiple of N
+    uint x_off;          // element offsets of the bindings
+    uint x_row_stride;
+    uint w_off;
+    uint w_ne0;          // weight length (broadcast over rows, modulo if shorter than W)
+    uint sign_off;
+    uint dst_off;
+    uint norm_off;
+    uint has_norm_out;
+    float eps;
+    float scale;         // 1/sqrt(N)
+};
+
+layout(binding = 0, std430) readonly buffer X { float data_x[]; };
+layout(binding = 1, std430) readonly buffer Wt { float data_w[]; };
+layout(binding = 2, std430) readonly buffer S { float data_s[]; };
+layout(binding = 3, std430) writeonly buffer D { float data_d[]; };
+layout(binding = 4, std430) writeonly buffer Nm { float data_n[]; };
+
+shared float shmem[N];
+shared float red[WG / 8];
+
+void main() {
+    const uint tid = gl_LocalInvocationID.x;
+    const uint sg = gl_SubgroupSize;
+    const uint blocks = row_width / N;
+
+    for (uint wgi = gl_WorkGroupID.x; wgi < n_rows * blocks; wgi += gl_NumWorkGroups.x) {
+        const uint row = wgi / blocks;
+        const uint blk = wgi % blocks;
+        const uint xrow = x_off + row * x_row_stride;
+
+        float ss = 0.0;
+        for (uint e = tid; e < row_width; e += WG) {
+            const float v = data_x[xrow + e];
+            ss += v * v;
+        }
+        ss = subgroupAdd(ss);
+        if (gl_SubgroupInvocationID == 0) {
+            red[gl_SubgroupID] = ss;
+        }
+        barrier();
+        float total = 0.0;
+        for (uint s = 0; s < gl_NumSubgroups; ++s) {
+            total += red[s];
+        }
+        barrier();
+        const float rs = inversesqrt(total / float(row_width) + eps);
+
+        float reg[EL];
+        [[unroll]] for (uint i = 0; i < EL; ++i) {
+            const uint col = blk * N + tid + WG * i;
+            const float xn = data_x[xrow + col] * rs * data_w[w_off + col % w_ne0];
+            if (has_norm_out != 0) {
+                data_n[norm_off + row * row_width + col] = xn;
+            }
+            reg[i] = xn * data_s[sign_off + col] * scale;
+        }
+
+        [[unroll]] for (uint h = 1; h < WG; h <<= 1) {
+            const bool upper = (tid & h) != 0;
+            if (h < sg) {
+                [[unroll]] for (uint i = 0; i < EL; ++i) {
+                    const float other = subgroupShuffleXor(reg[i], h);
+                    reg[i] = upper ? other - reg[i] : reg[i] + other;
+                }
+            } else {
+                [[unroll]] for (uint i = 0; i < EL; ++i) {
+                    shmem[tid + WG * i] = reg[i];
+                }
+                barrier();
+                [[unroll]] for (uint i = 0; i < EL; ++i) {
+                    const float other = shmem[(tid ^ h) + WG * i];
+                    reg[i] = upper ? other - reg[i] : reg[i] + other;
+                }
+                barrier();
+            }
+        }
+
+        [[unroll]] for (uint step = 1; step < EL; step <<= 1) {
+            [[unroll]] for (uint i = 0; i < EL; ++i) {
+                if ((i & step) == 0) {
+                    const float x = reg[i];
+                    const float y = reg[i + step];
+                    reg[i] = x + y;
+                    reg[i + step] = x - y;
+                }
+            }
+        }
+
+        [[unroll]] for (uint i = 0; i < EL; ++i) {
+            data_d[dst_off + wgi * N + tid + WG * i] = reg[i];
+        }
+    }
+}
