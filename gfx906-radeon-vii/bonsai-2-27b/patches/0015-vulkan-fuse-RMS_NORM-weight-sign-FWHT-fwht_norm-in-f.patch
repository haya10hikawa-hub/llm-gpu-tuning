+// {RMS_NORM(x), MUL(., w), MUL(., signs), RESHAPE, MUL_MAT(rot, .) with the Hadamard hint} -> one fwht_norm
+// dispatch. Returns 0 if not fusable, 1 if fusable, 2 if fusable but the weighted norm (node_idx+1) has other
+// consumers and must also be written.
+static int ggml_vk_can_fuse_norm_fwht(const ggml_backend_vk_context * ctx, const struct ggml_cgraph * cgraph, int node_idx) {
+    static const bool disabled = getenv("GGML_VK_DISABLE_NORM_FWHT") != nullptr;
+    if (disabled || node_idx + 4 >= cgraph->n_nodes) {
+        return 0;
+    }
+    const ggml_tensor * rn = cgraph->nodes[node_idx];
+    const ggml_tensor * mw = cgraph->nodes[node_idx + 1];
+    const ggml_tensor * ms = cgraph->nodes[node_idx + 2];
+    const ggml_tensor * rs = cgraph->nodes[node_idx + 3];
+    const ggml_tensor * mm = cgraph->nodes[node_idx + 4];
+    if (rn->op != GGML_OP_RMS_NORM || mw->op != GGML_OP_MUL || ms->op != GGML_OP_MUL || rs->op != GGML_OP_RESHAPE || mm->op != GGML_OP_MUL_MAT) {
+        return 0;
+    }
+    if (ggml_get_op_params_i32(mm, 1) != GGML_HINT_SRC0_IS_HADAMARD || mm->src[1] != rs || rs->src[0] != ms || rs->view_src != ms ||
+        ms->src[0] != mw || mw->src[0] != rn) {
+        return 0;
+    }
+    const ggml_tensor * x = rn->src[0];
+    const ggml_tensor * w = mw->src[1];
+    const ggml_tensor * signs = ms->src[1];
+    const int64_t n = mm->src[0]->ne[0];
+    const int idx = ggml_vk_fwht_pipeline_idx(n);
+    if (idx < 0 || ctx->device->pipeline_fwht_norm_f32[idx] == nullptr) {
+        return 0;
+    }
+    if (x->type != GGML_TYPE_F32 || w->type != GGML_TYPE_F32 || signs->type != GGML_TYPE_F32 || rn->type != GGML_TYPE_F32 ||
+        mw->type != GGML_TYPE_F32 || ms->type != GGML_TYPE_F32 || mm->type != GGML_TYPE_F32) {
+        return 0;
+    }
+    // row-wise norm over ne0, weight broadcast along ne0 only, one sign vector across the row
+    if (x->nb[0] != sizeof(float) || ggml_nrows(x) != ggml_nrows(rn) || x->ne[2] * x->ne[3] != 1 ||
+        !ggml_is_contiguous(w) || ggml_nrows(w) != 1 || x->ne[0] % w->ne[0] != 0 ||
+        !ggml_is_contiguous(signs) || ggml_nrows(signs) != 1 || signs->ne[0] != x->ne[0] || x->ne[0] % n != 0 ||
+        !ggml_is_contiguous(mw) || !ggml_is_contiguous(mm)) {
+        return 0;
+    }
+    if ((uint32_t)ggml_nrows(x) > ggml_vk_fwht_row_max()) {
+        return 0;
+    }
+    // the norm and the sign flip (and its reshape) must only feed the next node; the weighted norm may have
+    // other consumers, which then read the second output
+    if (ggml_node_get_use_count(cgraph, node_idx) != 1 || ggml_node_get_use_count(cgraph, node_idx + 2) != 1 ||
+        ggml_node_get_use_count(cgraph, node_idx + 3) != 1 ||
+        (rn->flags & GGML_TENSOR_FLAG_OUTPUT) || (ms->flags & GGML_TENSOR_FLAG_OUTPUT) || (rs->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+        return 0;
+    }
+    const bool dual = ggml_node_get_use_count(cgraph, node_idx + 1) != 1 || (mw->flags & GGML_TENSOR_FLAG_OUTPUT);
+    return dual ? 2 : 1;
+}
+
+static void ggml_vk_norm_fwht(ggml_backend_vk_context * ctx, vk_context& subctx, const struct ggml_cgraph * cgraph, int node_idx, bool dual) {
+    const ggml_tensor * rn = cgraph->nodes[node_idx];
+    ggml_tensor * mw = cgraph->nodes[node_idx + 1];
+    const ggml_tensor * ms = cgraph->nodes[node_idx + 2];
+    ggml_tensor * mm = cgraph->nodes[node_idx + 4];
+    const ggml_tensor * x = rn->src[0];
+    const ggml_tensor * w = mw->src[1];
+    const ggml_tensor * signs = ms->src[1];
+    const int64_t n = mm->src[0]->ne[0];
+    const int idx = ggml_vk_fwht_pipeline_idx(n);
+    vk_pipeline pipeline = ctx->device->pipeline_fwht_norm_f32[idx];
+    GGML_ASSERT(pipeline != nullptr);
+
+    const uint32_t n_rows = (uint32_t)ggml_nrows(x);
+    const uint32_t W = (uint32_t)x->ne[0];
+    const uint32_t n_wg = std::min<uint32_t>(n_rows * (W / (uint32_t)n), ctx->device->properties.limits.maxComputeWorkGroupCount[0]);
+    ggml_pipeline_request_descriptor_sets(ctx, pipeline, 1);
+
+    const vk_subbuffer x_buf = ggml_vk_tensor_subbuffer(ctx, x, true);
+    const vk_subbuffer w_buf = ggml_vk_tensor_subbuffer(ctx, w, true);
+    const vk_subbuffer s_buf = ggml_vk_tensor_subbuffer(ctx, signs, true);
+    const vk_subbuffer d_buf = ggml_vk_tensor_subbuffer(ctx, mm, true);
+    const vk_subbuffer n_buf = dual ? ggml_vk_tensor_subbuffer(ctx, mw, true) : d_buf;
+
+    float eps;
+    memcpy(&eps, rn->op_params, sizeof(float));
+    const vk_op_fwht_norm_push_constants pc = {
+        n_rows, W,
+        (uint32_t)(get_misalign_bytes(ctx, x) / sizeof(float)), (uint32_t)(x->nb[1] / sizeof(float)),
+        (uint32_t)(get_misalign_bytes(ctx, w) / sizeof(float)), (uint32_t)w->ne[0],
+        (uint32_t)(get_misalign_bytes(ctx, signs) / sizeof(float)),
+        (uint32_t)(get_misalign_bytes(ctx, mm) / sizeof(float)),
+        dual ? (uint32_t)(get_misalign_bytes(ctx, mw) / sizeof(float)) : 0u,
+        dual ? 1u : 0u,
+        eps, 1.0f / std::sqrt((float)n),
+    };
+    ggml_vk_dispatch_pipeline(ctx, subctx, pipeline, { x_buf, w_buf, s_buf, d_buf, n_buf }, pc, { n_wg, 1, 1 });
+}
+
