+                if (nf == 2) {
+                    ctx->fused_ops_write_mask |= 1 << 1;
+                }
             } else if (ggml_vk_can_fuse_mul_fwht(ctx, cgraph, i)) {
                 ctx->num_additional_fused_ops = 2;
                 ctx->fused_mul_fwht = true;
@@ -17687,6 +17817,8 @@ static ggml_status ggml_backend_vk_graph_compute(ggml_backend_t backend, ggml_cg
                 ctx->fused_topk_moe_mode = TOPK_MOE_COUNT;
                 ctx->fused_topk_moe_scale = false;
                 ctx->fused_mul_fwht = false;
+                ctx->fused_norm_fwht = false;
+                ctx->fused_norm_fwht_dual = false;
             }
         }
 
@@ -17839,6 +17971,13 @@ static void ggml_vk_graph_optimize(ggml_backend_t backend, struct ggml_cgraph *
 
         // sign flip + reshape + Hadamard-hinted matmul: fused into one FWHT dispatch (ggml_vk_can_fuse_mul_fwht)
