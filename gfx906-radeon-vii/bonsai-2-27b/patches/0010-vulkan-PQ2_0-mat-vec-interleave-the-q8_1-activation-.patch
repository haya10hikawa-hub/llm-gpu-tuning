 }
 #endif
 
-#if defined(DATA_A_Q2_0) || defined(DATA_A_PQ2_0)
+#if defined(DATA_A_PQ2_0)
+// B comes from quantize_q8_1_x4_i4: in each 16-value half, dword m holds values m, m+4, m+8, m+12. Code j of the
+// 16 codes in `bits` sits at bits 2j, so (bits >> 2m) & 0x03030303 lines up with dword m byte for byte.
+FLOAT_TYPE mmvq_dot_product(const uint ib_a, const uint iqs) {
+    const uint qs_idx = (ib_a & 3u) * 4u + iqs * 2u;
+    const uint bits = pack32(u16vec2(data_a_packed16[ib_a / 4].qs[qs_idx],
+                                     data_a_packed16[ib_a / 4].qs[qs_idx + 1]));
+    int32_t q_sum = dotPacked4x8EXT(int32_t(bits & 0x03030303u), cache_b_qs[0]);
+    q_sum += dotPacked4x8EXT(int32_t((bits >> 2u) & 0x03030303u), cache_b_qs[1]);
+    q_sum += dotPacked4x8EXT(int32_t((bits >> 4u) & 0x03030303u), cache_b_qs[2]);
+    q_sum += dotPacked4x8EXT(int32_t((bits >> 6u) & 0x03030303u), cache_b_qs[3]);
+
+    // 16 quants per call => divide sums by 32/16 = 2
+    return mul_q8_1(q_sum, get_dm(ib_a), cache_b_ds, 2);
+}
+#elif defined(DATA_A_Q2_0)
 FLOAT_TYPE mmvq_dot_product(const uint ib_a, const uint iqs) {
     int32_t q_sum = 0;
     const i32vec4 qs_a = repack4(ib_a, iqs);
