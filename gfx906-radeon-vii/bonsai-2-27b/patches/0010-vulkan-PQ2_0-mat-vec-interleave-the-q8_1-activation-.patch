 layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;
 
 layout (binding = 0) readonly buffer A {vec4 data_a[];};
+#ifdef QUANT_INTERLEAVE4
+// scalar view of the same input, for the strided gather below
+layout (binding = 0) readonly buffer AF {float data_af[];};
+#endif
 #ifndef QBLOCK_X4
 layout (binding = 1) writeonly buffer D {block_q8_1_packed32 data_b[];};
 #else
@@ -57,7 +61,17 @@ void quantize(const uint wgid) {
 
     const uint a_idx = ib * 8 + iqs;
 
+#ifdef QUANT_INTERLEAVE4
+    // dword iqs of the 32-value block holds values m, m+4, m+8, m+12 of its 16-value half (m = iqs % 4),
+    // the order the PQ2_0 mat-vec extracts its 2-bit codes in. amax and the block sum see the same 32 values.
+    const uint e0 = ib * 32 + (iqs / 4) * 16 + (iqs % 4);
+    vec4 vals = vec4(e0      < p.ne ? data_af[e0]      : 0.0f,
+                     e0 + 4  < p.ne ? data_af[e0 + 4]  : 0.0f,
+                     e0 + 8  < p.ne ? data_af[e0 + 8]  : 0.0f,
+                     e0 + 12 < p.ne ? data_af[e0 + 12] : 0.0f);
+#else
     vec4 vals = a_idx < p.ne / 4 ? data_a[a_idx] : vec4(0.0f);
+#endif
     const vec4 abs_vals = abs(vals);
 
     // Find absolute max for each block
