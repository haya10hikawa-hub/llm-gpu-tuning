-static void ggml_vk_quantize_q8_1(ggml_backend_vk_context * ctx, vk_context& subctx, const vk_subbuffer & in, const vk_subbuffer & out, uint32_t ne) {
+// q8_1 activations for a mat-vec over src0 of type a_type: PQ2_0 reads them in the interleaved order
+static vk_pipeline ggml_vk_get_quantize_pipeline_matvec(ggml_backend_vk_context * ctx, ggml_type a_type) {
