From 91162d568b5d454bc60b5e96083d6427eaff99ea Mon Sep 17 00:00:00 2001
From: bench <bench@local>
Date: Fri, 25 Sep 2026 03:40:47 +0000
Subject: [PATCH 02/24] vulkan: env knobs for matvec rows/wg size; tests:
 Bonsai decode matvec perf cases

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/src/ggml-vulkan/ggml-vulkan.cpp | 15 ++++++++++++++-
 tests/test-backend-ops.cpp           | 14 ++++++++++++++
 2 files changed, 28 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-vulkan/ggml-vulkan.cpp b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
index f4fa37d..6bd8bad 100644
--- a/ggml/src/ggml-vulkan/ggml-vulkan.cpp
+++ b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
@@ -5235,7 +5235,15 @@ static void ggml_vk_load_shaders(vk_device& device, vk_pipeline requested) {
         rm_stdq = 2;
         rm_stdq_int = 2;
     }
-    uint32_t rm_iq = 2 * rm_kq;
+    auto const env_u32 = [](const char * name, uint32_t def) {
+        const char * v = getenv(name);
+        return v ? (uint32_t) std::max(1, atoi(v)) : def;
+    };
+    rm_stdq = env_u32("GGML_VK_RM_STDQ", rm_stdq);
+    rm_kq = env_u32("GGML_VK_RM_KQ", rm_kq);
+    rm_stdq_int = env_u32("GGML_VK_RM_STDQ_INT", rm_stdq_int);
+    rm_kq_int = env_u32("GGML_VK_RM_KQ_INT", rm_kq_int);
+    uint32_t rm_iq = env_u32("GGML_VK_RM_IQ", 2 * rm_kq);
 
     const bool use_subgroups = device->subgroup_arithmetic;
     // Ensure a subgroup size >= 16 is available
@@ -7920,6 +7928,11 @@ static vk_pipeline ggml_vk_get_dequantize_mul_mat_vec(ggml_backend_vk_context *
         }
     }
 
+    static const char * dmmv_wg_env = getenv("GGML_VK_DMMV_WG");
+    if (dmmv_wg_env) {
+        dmmv_wg = atoi(dmmv_wg_env) ? DMMV_WG_SIZE_LARGE : DMMV_WG_SIZE_SUBGROUP;
+    }
+
     if (b_type == GGML_TYPE_Q8_1) {
         if (ctx->device->vendor_id == VK_VENDOR_ID_INTEL) {
             dmmv_wg = DMMV_WG_SIZE_SUBGROUP;
diff --git a/tests/test-backend-ops.cpp b/tests/test-backend-ops.cpp
index 6510e15..497a932 100644
--- a/tests/test-backend-ops.cpp
+++ b/tests/test-backend-ops.cpp
@@ -10302,6 +10302,20 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_eval() {
 // Test cases for performance evaluation: should be representative of real-world use cases
 static std::vector<std::unique_ptr<test_case>> make_test_cases_perf() {
     std::vector<std::unique_ptr<test_case>> test_cases;
+
+    // decode matvec shapes of Bonsai 2 27B (PQ2_0 / PTQ1_0), n = 1
+    {
+        const std::pair<int64_t, int64_t> shapes[] = {{17408, 5120}, {5120, 17408}, {10240, 5120}, {12288, 5120}, {6144, 5120}, {5120, 6144}};
+        for (ggml_type t : {GGML_TYPE_PQ2_0, GGML_TYPE_PTQ1_0, GGML_TYPE_Q8_0}) {
+            for (auto [m, k] : shapes) {
+                test_cases.emplace_back(new test_mul_mat(t, GGML_TYPE_F32, m, 1, k, {1, 1}, {1, 1}));
+            }
+        }
+        test_cases.emplace_back(new test_mul_mat(GGML_TYPE_PQ2_0, GGML_TYPE_F32, 248320, 1, 5120, {1, 1}, {1, 1}));
+        // bandwidth probes: nearly compute-free streaming reads of the same size class
+        test_cases.emplace_back(new test_mul_mat(GGML_TYPE_F16, GGML_TYPE_F32, 17408, 1, 5120, {1, 1}, {1, 1}));
+        test_cases.emplace_back(new test_mul_mat(GGML_TYPE_F32, GGML_TYPE_F32, 17408, 1, 5120, {1, 1}, {1, 1}));
+    }
     // bandwidth comparison at Bonsai-2 shapes
     for (ggml_type t : {GGML_TYPE_PTQ1_0, GGML_TYPE_PQ2_0, GGML_TYPE_Q4_0, GGML_TYPE_Q8_0, GGML_TYPE_Q2_K, GGML_TYPE_TQ2_0}) {
         test_cases.emplace_back(new test_mul_mat(t, GGML_TYPE_F32, 17408, 1, 5120, {1, 1}, {1, 1}));
-- 
2.53.0

