From 8fbe43ac968de4f242af745c614d29c82322e5ce Mon Sep 17 00:00:00 2001
From: bench <bench@local>
Date: Sat, 26 Sep 2026 11:37:56 +0000
Subject: [PATCH 32/34] vulkan: PQ2_0 MMVQ takes 32 weights (one q8_1 block)
 per thread and step

Removing the weight loads left 24.6 of 40.5 us (5120x17408): the path is VALU-bound. 32 weights per step run the
scale arithmetic and the scale load once per 32 values. Matvec -7..14%, decode +4..8%, KLD 0.0011 vs 0.0010.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 .../vulkan-shaders/mul_mat_vecq.comp          | 44 +++++++++++--------
 1 file changed, 25 insertions(+), 19 deletions(-)

diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vecq.comp b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vecq.comp
index 3eca25d..5ad5dde 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vecq.comp
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vecq.comp
@@ -29,26 +29,32 @@ vec2 cache_b_ds;
 #include "mul_mat_vecq_funcs.glsl"
 
 #if defined(DATA_A_PQ2_0)
-// PQ2_0 path: addresses computed once per thread and row, then advanced by constants (see pq2 notes above main)
+// PQ2_0 path: 32 weights per thread and step (pq2_mv32_patch.py), addresses advanced by constants
 layout (binding = 0) readonly buffer A_PQ2_U16 { uint16_t data_a_u16[]; };
 layout (binding = 1) readonly buffer B_Q81_U32 { uint32_t data_b_u32[]; };
 layout (binding = 1) readonly buffer B_Q81_V4 { uvec4 data_b_v4[]; };
 
-// one k step (16 values) for every row and column; a is the u16 index of this thread's PQ2_0 block in row 0,
-// bq / bd the uvec4 index of its 16 q8_1 bytes and the dword index of their (d, d*sum) per column
+// one 32-weight step for every row and column; a is the u16 index of this thread's PQ2_0 block in row 0,
+// bq / bd the uvec4 index of its 32 q8_1 bytes and the dword index of their (d, d*sum) per column
 void iter_pq2(inout FLOAT_TYPE temp[NUM_COLS][NUM_ROWS], const uint num_rows, const uint a, const uint row_u16,
               const uint q_in, const uint bq[NUM_COLS], const uint bd[NUM_COLS]) {
     [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
         const vec2 ds = unpackHalf2x16(data_b_u32[bd[j]]);
-        const ivec4 b = ivec4(data_b_v4[bq[j]]);
+        const ivec4 b0 = ivec4(data_b_v4[bq[j]]);
+        const ivec4 b1 = ivec4(data_b_v4[bq[j] + 1]);
         [[unroll]] for (uint n = 0; n < num_rows; ++n) {
             const uint ai = a + n * row_u16;
-            const uint bits = pack32(u16vec2(data_a_u16[ai + q_in], data_a_u16[ai + q_in + 1]));
-            int32_t q_sum = dotPacked4x8EXT(int32_t(bits & 0x03030303u), b.x);
-            q_sum += dotPacked4x8EXT(int32_t((bits >> 2u) & 0x03030303u), b.y);
-            q_sum += dotPacked4x8EXT(int32_t((bits >> 4u) & 0x03030303u), b.z);
-            q_sum += dotPacked4x8EXT(int32_t((bits >> 6u) & 0x03030303u), b.w);
-            temp[j][n] += mul_q8_1(q_sum, unpackHalf2x16(uint(data_a_u16[ai])).x, ds, 2);
+            const uint c0 = pack32(u16vec2(data_a_u16[ai + q_in], data_a_u16[ai + q_in + 1]));
+            const uint c1 = pack32(u16vec2(data_a_u16[ai + q_in + 2], data_a_u16[ai + q_in + 3]));
+            int32_t q_sum = dotPacked4x8EXT(int32_t(c0 & 0x03030303u), b0.x);
+            q_sum += dotPacked4x8EXT(int32_t((c0 >> 2u) & 0x03030303u), b0.y);
+            q_sum += dotPacked4x8EXT(int32_t((c0 >> 4u) & 0x03030303u), b0.z);
+            q_sum += dotPacked4x8EXT(int32_t((c0 >> 6u) & 0x03030303u), b0.w);
+            q_sum += dotPacked4x8EXT(int32_t(c1 & 0x03030303u), b1.x);
+            q_sum += dotPacked4x8EXT(int32_t((c1 >> 2u) & 0x03030303u), b1.y);
+            q_sum += dotPacked4x8EXT(int32_t((c1 >> 4u) & 0x03030303u), b1.z);
+            q_sum += dotPacked4x8EXT(int32_t((c1 >> 6u) & 0x03030303u), b1.w);
+            temp[j][n] += mul_q8_1(q_sum, unpackHalf2x16(uint(data_a_u16[ai])).x, ds, 1);
         }
     }
 }
@@ -67,26 +73,26 @@ void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
         }
     }
 
-    const uint col_stride = K_PER_ITER * BLOCK_SIZE;
+    const uint col_stride = 32 * BLOCK_SIZE;
     uint num_iters = p.ncols / col_stride;
-    if (num_iters * col_stride + K_PER_ITER * tid < p.ncols) {
+    if (num_iters * col_stride + 32 * tid < p.ncols) {
         num_iters++;
     }
 
-    // thread tid reads values [16 tid, 16 tid + 16) of each col_stride: PQ2_0 block tid / 8 of the stride, its
-    // codes at u16 1 + 2 (tid % 8), its scale at u16 0 (a block is 17 u16)
+    // thread tid reads values [32 tid, 32 tid + 32) of each col_stride: PQ2_0 block tid / 4, its codes at
+    // u16 1 + 4 (tid % 4), its scale at u16 0 (a block is 17 u16); q8_1 block tid of the stride
     const uint blocks_step = col_stride / QUANT_K;
     const uint row_u16 = (p.ncols / QUANT_K) * 17;
-    const uint q_in = 1 + (tid % 8) * 2;
-    uint a = (first_row * (p.ncols / QUANT_K) + a_offset + tid / 8) * 17;
+    const uint q_in = 1 + (tid % 4) * 4;
+    uint a = (first_row * (p.ncols / QUANT_K) + a_offset + tid / 4) * 17;
     const uint a_step = blocks_step * 17;
 
-    // q8_1 block (32 values) tid / 2 of the stride, 16-value half tid % 2; a q8_1_x4 block is 9 uvec4 / 36 dwords
+    // q8_1_x4 block = 9 uvec4 (ds, then 8 x 16 bytes) = 36 dwords
     uint bq[NUM_COLS];
     uint bd[NUM_COLS];
     [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
-        const uint bb = (j * p.batch_stride_b) / QUANT_K_Q8_1 + b_offset + tid / 2;
-        bq[j] = (bb / 4) * 9 + 1 + (bb % 4) * 2 + (tid % 2);
+        const uint bb = (j * p.batch_stride_b) / QUANT_K_Q8_1 + b_offset + tid;
+        bq[j] = (bb / 4) * 9 + 1 + (bb % 4) * 2;
         bd[j] = (bb / 4) * 36 + (bb % 4);
     }
     const uint bq_step = blocks_step * 9;
