From c9457d57718cee783965d081dc866d79dcac8df3 Mon Sep 17 00:00:00 2001
From: bench <bench@local>
Date: Fri, 25 Sep 2026 11:00:20 +0000
Subject: [PATCH 19/34] sampling: apply penalties to the penalized tokens only
 when candidates are indexed by id

One unordered_map lookup per candidate cost 2.9 ms per token for a 248k vocabulary (64-token window), with the
GPU idle; visiting the counted tokens directly takes 0.001 ms and gives bit-identical logits. Sorted or truncated
arrays keep the old loop.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/llama-sampler.cpp | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/src/llama-sampler.cpp b/src/llama-sampler.cpp
index 34a7988..28c3507 100644
--- a/src/llama-sampler.cpp
+++ b/src/llama-sampler.cpp
@@ -2954,6 +2954,27 @@ static void llama_sampler_penalties_apply(struct llama_sampler * smpl, llama_tok
         return;
     }
 
+    // fast path: the candidates are still indexed by token id (the full, unsorted array), so visit only the
+    // penalized tokens instead of looking every candidate up in token_count
+    bool direct = cur_p->size > 4 * ctx->token_count.size();
+    for (auto it = ctx->token_count.begin(); direct && it != ctx->token_count.end(); ++it) {
+        const llama_token t = it->first;
+        direct = t >= 0 && (size_t) t < cur_p->size && cur_p->data[t].id == t;
+    }
+    if (direct) {
+        for (const auto & [t, count] : ctx->token_count) {
+            auto & td = cur_p->data[t];
+            if (td.logit <= 0) {
+                td.logit *= ctx->penalty_repeat;
+            } else {
+                td.logit /= ctx->penalty_repeat;
+            }
+            td.logit -= float(count) * ctx->penalty_freq + float(count > 0) * ctx->penalty_present;
+        }
+        cur_p->sorted = false;
+        return;
+    }
+
     // Apply frequency and presence penalties to the cur_p
     for (size_t i = 0; i < cur_p->size; ++i) {
         const auto token_iter = ctx->token_count.find(cur_p->data[i].id);
-- 
