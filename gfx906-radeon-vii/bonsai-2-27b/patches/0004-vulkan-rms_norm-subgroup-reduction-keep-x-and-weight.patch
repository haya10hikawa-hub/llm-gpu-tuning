From 05cf31ce1ede7b60cf411df2af3c1ae89388331d Mon Sep 17 00:00:00 2001
From: bench <bench@local>
Date: Fri, 25 Sep 2026 04:02:57 +0000
Subject: [PATCH 04/24] vulkan: rms_norm: subgroup reduction, keep x and weight
 in registers

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../ggml-vulkan/vulkan-shaders/rms_norm.comp  | 60 ++++++++++++-------
 1 file changed, 37 insertions(+), 23 deletions(-)

diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/rms_norm.comp b/ggml/src/ggml-vulkan/vulkan-shaders/rms_norm.comp
index 55b89f1..f8f19be 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/rms_norm.comp
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/rms_norm.comp
@@ -30,7 +30,11 @@ layout (binding = 6) readonly buffer R_I {uvec2 rope_data_i[];}; // indices for
 #endif
 
 #extension GL_EXT_control_flow_attributes : enable
+#extension GL_KHR_shader_subgroup_basic : require
+#extension GL_KHR_shader_subgroup_arithmetic : require
 #define BLOCK_SIZE 512
+// x (and the multiplier) stay in registers between the two passes up to this many iterations
+#define CACHE_ITERS 16
 
 layout (constant_id = 1) const bool do_multiply = false;
 
@@ -38,7 +42,7 @@ layout(local_size_x = BLOCK_SIZE, local_size_y = 1, local_size_z = 1) in;
 
 shared FLOAT_TYPE sumsh[BLOCK_SIZE];
 
-void rms_norm(uint num_iters) {
+void rms_norm(uint num_iters, const bool cache) {
     const uint ncols     = p.ne00;
     const uint nrows     = gl_NumWorkGroups.x;
     const uint nchannels = gl_NumWorkGroups.y;
@@ -61,26 +65,36 @@ void rms_norm(uint num_iters) {
     uint32_t d_offset = ((samp*nchannels + channel)*nrows + row)*ncols + get_doffset();
 #endif
     FLOAT_TYPE sum = FLOAT_TYPE(0.0f); // partial sum for thread in warp
+    FLOAT_TYPE xv[CACHE_ITERS];
+    FLOAT_TYPE bv[CACHE_ITERS];
+    const bool bcast = ncols > p.ne10;
 
     [[unroll]] for (uint col = tid, idx = 0; idx < num_iters; col += BLOCK_SIZE, ++idx) {
         FLOAT_TYPE xi = FLOAT_TYPE(0);
+        FLOAT_TYPE bi = FLOAT_TYPE(0);
         if (col < ncols) {
             xi = FLOAT_TYPE(data_a[a_offset + col]);
+            if (cache && do_multiply) {
+                bi = FLOAT_TYPE(data_b[b_offset + (bcast ? fastmod(col, p.ne10) : col)]);
+            }
+        }
+        if (cache) {
+            xv[idx] = xi;
+            bv[idx] = bi;
         }
         sum += xi * xi;
     }
 
-    sumsh[tid] = sum;
-    // sum up partial sums and write back result
+    // one subgroup reduction, then the per-subgroup partials through shared memory
+    sum = subgroupAdd(sum);
+    if (gl_SubgroupInvocationID == 0) {
+        sumsh[gl_SubgroupID] = sum;
+    }
     barrier();
-    [[unroll]] for (int s = BLOCK_SIZE / 2; s > 0; s >>= 1) {
-        if (tid < s) {
-            sum += sumsh[tid + s];
-            sumsh[tid] = sum;
-        }
-        barrier();
+    sum = FLOAT_TYPE(0.0f);
+    for (uint sg = 0; sg < gl_NumSubgroups; ++sg) {
+        sum += sumsh[sg];
     }
-    sum = sumsh[0];
 
     const FLOAT_TYPE mean = sum / FLOAT_TYPE(ncols);
     const FLOAT_TYPE scale = inversesqrt(mean + FLOAT_TYPE(p.param1));
@@ -91,14 +105,14 @@ void rms_norm(uint num_iters) {
                 if (col >= ncols) {
                     continue;
                 }
-                data_d[d_offset + col] = D_TYPE(scale * FLOAT_TYPE(data_a[a_offset + col]) * FLOAT_TYPE(data_b[b_offset + fastmod(col, p.ne10)]));
+                data_d[d_offset + col] = D_TYPE(scale * (cache ? xv[idx] : FLOAT_TYPE(data_a[a_offset + col])) * (cache ? bv[idx] : FLOAT_TYPE(data_b[b_offset + fastmod(col, p.ne10)])));
             }
         } else {
             [[unroll]] for (uint col = tid, idx = 0; idx < num_iters; col += BLOCK_SIZE, ++idx) {
                 if (col >= ncols) {
                     continue;
                 }
-                data_d[d_offset + col] = D_TYPE(scale * FLOAT_TYPE(data_a[a_offset + col]) * FLOAT_TYPE(data_b[b_offset + col]));
+                data_d[d_offset + col] = D_TYPE(scale * (cache ? xv[idx] : FLOAT_TYPE(data_a[a_offset + col])) * (cache ? bv[idx] : FLOAT_TYPE(data_b[b_offset + col])));
             }
         }
     } else {
@@ -106,7 +120,7 @@ void rms_norm(uint num_iters) {
             if (col >= ncols) {
                 continue;
             }
-            data_d[d_offset + col] = D_TYPE(scale * FLOAT_TYPE(data_a[a_offset + col]));
+            data_d[d_offset + col] = D_TYPE(scale * (cache ? xv[idx] : FLOAT_TYPE(data_a[a_offset + col])));
         }
     }
 #if RMS_NORM_ROPE_FUSION
@@ -127,24 +141,24 @@ void main() {
     // dimensions, to allow loop unrolling
     uint num_blocks = (p.ne00 + BLOCK_SIZE - 1) / BLOCK_SIZE;
     if (num_blocks > 32) {
-        rms_norm(num_blocks);
+        rms_norm(num_blocks, false);
     } else if (num_blocks > 16) {
-        rms_norm(32);
+        rms_norm(32, false);
     } else if (num_blocks > 12) {
-        rms_norm(16);
+        rms_norm(16, true);
     } else if (num_blocks > 10) {
-        rms_norm(12);
+        rms_norm(12, true);
     } else if (num_blocks > 8) {
-        rms_norm(10);
+        rms_norm(10, true);
     } else if (num_blocks > 4) {
-        rms_norm(8);
+        rms_norm(8, true);
     } else if (num_blocks == 4) {
-        rms_norm(4);
+        rms_norm(4, true);
     } else if (num_blocks == 3) {
-        rms_norm(3);
+        rms_norm(3, true);
     } else if (num_blocks == 2) {
-        rms_norm(2);
+        rms_norm(2, true);
     } else if (num_blocks == 1) {
-        rms_norm(1);
+        rms_norm(1, true);
     }
 }
-- 
