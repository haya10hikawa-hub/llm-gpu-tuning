+// decode step of the gated-delta-net short convolution: CONCAT(conv state row, x^T), SSM_CONV + SILU and the
+// shifted window copied back over the state row, the shape the Vulkan backend runs as one conv_step dispatch
+struct test_conv_step : public test_case {
+    const int64_t C;
+
+    test_conv_step(int64_t C = 10240) : C(C) {}
+
+    std::string vars() override {
+        return VARS_TO_STR1(C);
+    }
+
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return "CONV_STEP";
+    }
+
+    bool run_whole_graph() override { return true; }
+
+    ggml_tensor * silu_out = nullptr;
+    ggml_tensor * cache_out = nullptr;
+
+    std::vector<ggml_tensor *> fusion_test_nodes() override {
+        return { silu_out, cache_out };
+    }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * cache = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 3 * C, 3);
+        ggml_set_name(cache, "cache");
+        ggml_tensor * x = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, C, 1);
+        ggml_tensor * w = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 4, C);
+        ggml_tensor * st = ggml_reshape_3d(ctx, ggml_view_2d(ctx, cache, 3 * C, 1, cache->nb[1], cache->nb[1]), 3, C, 1);
+        ggml_tensor * cat = ggml_concat(ctx, st, ggml_transpose(ctx, x), 0);
+        silu_out = ggml_silu(ctx, ggml_ssm_conv(ctx, cat, w));
+        ggml_tensor * last = ggml_view_3d(ctx, cat, 3, C, 1, cat->nb[1], cat->nb[2], ggml_row_size(cat->type, 1));
+        cache_out = ggml_cpy(ctx, last, ggml_view_2d(ctx, cache, 3 * C, 1, cache->nb[1], cache->nb[1]));
+        ggml_tensor * out = ggml_add(ctx, ggml_sum(ctx, silu_out), ggml_sum(ctx, cache_out));
+        ggml_set_name(out, "out");
+        return out;
+    }
+};
