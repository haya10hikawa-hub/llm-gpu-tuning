+// a skipped node must not be the last one computed: that one closes and submits the command buffer
+static bool ggml_vk_has_later_work(const struct ggml_cgraph * cgraph, int node_idx) {
+    for (int j = node_idx + 1; j < cgraph->n_nodes; j++) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (!ggml_is_empty(n) && !ggml_op_is_empty(n->op) && n->buffer && (n->flags & GGML_TENSOR_FLAG_COMPUTE)) {
+            return true;
+        }
+    }
+    return false;
+}
