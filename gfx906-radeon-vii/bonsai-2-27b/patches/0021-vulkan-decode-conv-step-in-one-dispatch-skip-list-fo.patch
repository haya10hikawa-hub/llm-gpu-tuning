+// Decode conv step: CONCAT(st = conv state, x^T) at node_idx, SSM_CONV(cat, w) + SILU, and CPY(view(cat, 1..3) ->
+// st memory). When st is only read by the CONCAT, the concat only feeds those two and real work follows, returns
+// true with the SSM_CONV, SILU and CPY nodes.
+static bool ggml_vk_can_conv_step(const ggml_backend_vk_context * ctx, const struct ggml_cgraph * cgraph, int node_idx,
+                                  const ggml_tensor ** conv, const ggml_tensor ** silu, const ggml_tensor ** cpy) {
+    static const bool disabled = getenv("GGML_VK_DISABLE_CONV_STEP") != nullptr;
+    const ggml_tensor * cat = cgraph->nodes[node_idx];
+    if (disabled || ctx->device->pipeline_conv_step_f32 == nullptr || cat->op != GGML_OP_CONCAT ||
+        ggml_get_op_params_i32(cat, 0) != 0) {
+        return false;
+    }
+    const ggml_tensor * st = cat->src[0];
+    const ggml_tensor * x = cat->src[1];
+    if (st->type != GGML_TYPE_F32 || x->type != GGML_TYPE_F32 || cat->type != GGML_TYPE_F32 || !ggml_is_contiguous(st) ||
+        st->ne[0] != 3 || x->ne[0] != 1 || x->ne[1] != st->ne[1] || st->ne[2] != 1 || x->ne[2] != 1 ||
+        st->ne[3] != 1 || x->ne[3] != 1 || x->nb[1] % sizeof(float) != 0 || st->view_src == nullptr) {
+        return false;
+    }
+    const int cat_uses = ggml_node_get_use_count(cgraph, node_idx);
+    const int st_idx = ggml_vk_node_index(cgraph, st, 0);
+    if (cat_uses != 2 || (st_idx >= 0 && ggml_node_get_use_count(cgraph, st_idx) != 1)) {
+        return false;
+    }
+    *conv = *silu = *cpy = nullptr;
+    for (int j = node_idx + 1; j < cgraph->n_nodes && j <= node_idx + 48; j++) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (n->op == GGML_OP_SSM_CONV && n->src[0] == cat && *conv == nullptr) {
+            const ggml_tensor * w = n->src[1];
+            if (j + 1 >= cgraph->n_nodes || w->type != GGML_TYPE_F32 || w->ne[0] != 4 || w->ne[1] != st->ne[1] ||
+                w->nb[0] != sizeof(float) || ggml_node_get_use_count(cgraph, j) != 1) {
+                return false;
+            }
+            const ggml_tensor * sl = cgraph->nodes[j + 1];
+            if (sl->op != GGML_OP_UNARY || ggml_get_unary_op(sl) != GGML_UNARY_OP_SILU || sl->src[0] != n ||
+                sl->type != GGML_TYPE_F32 || !ggml_is_contiguous(sl)) {
+                return false;
+            }
+            *conv = n;
+            *silu = sl;
+        } else if (n->op == GGML_OP_CPY && n->src[0]->view_src == cat && *cpy == nullptr) {
+            const ggml_tensor * v = n->src[0];
+            const int v_idx = ggml_vk_node_index(cgraph, v, node_idx);
+            if (v->view_offs != sizeof(float) || v->ne[0] != 3 || v->ne[1] != st->ne[1] || v_idx < 0 ||
+                ggml_node_get_use_count(cgraph, v_idx) != 1 || n->type != GGML_TYPE_F32 || !ggml_is_contiguous(n) ||
+                n->buffer != st->buffer || n->data != st->data || ggml_nbytes(n) != ggml_nbytes(st)) {
+                return false;
+            }
+            *cpy = n;
+        }
+        if (*conv && *cpy) {
+            const int last = std::max(ggml_vk_node_index(cgraph, *silu, node_idx), ggml_vk_node_index(cgraph, *cpy, node_idx));
+            return ggml_vk_has_later_work(cgraph, last);
+        }
+    }
+    return false;
+}
+
+static void ggml_vk_conv_step(ggml_backend_vk_context * ctx, vk_context& subctx, const ggml_tensor * cat,
+                              const ggml_tensor * conv, const ggml_tensor * silu, const ggml_tensor * cpy) {
+    const ggml_tensor * st = cat->src[0];
+    const ggml_tensor * x = cat->src[1];
+    const ggml_tensor * w = conv->src[1];
+    vk_pipeline pipeline = ctx->device->pipeline_conv_step_f32;
+    ggml_pipeline_request_descriptor_sets(ctx, pipeline, 1);
+
+    const uint32_t C = (uint32_t)st->ne[1];
+    const vk_op_conv_step_push_constants pc = {
+        C,
+        (uint32_t)(get_misalign_bytes(ctx, st) / sizeof(float)),
+        (uint32_t)(get_misalign_bytes(ctx, x) / sizeof(float)), (uint32_t)(x->nb[1] / sizeof(float)),
+        (uint32_t)(get_misalign_bytes(ctx, w) / sizeof(float)), (uint32_t)(w->nb[1] / sizeof(float)),
+        (uint32_t)(get_misalign_bytes(ctx, silu) / sizeof(float)),
+    };
+    ggml_vk_dispatch_pipeline(ctx, subctx, pipeline,
+        { ggml_vk_tensor_subbuffer(ctx, st, true), ggml_vk_tensor_subbuffer(ctx, x, true),
+          ggml_vk_tensor_subbuffer(ctx, w, true), ggml_vk_tensor_subbuffer(ctx, silu, true) },
+        pc, { C, 1, 1 });
+
+    // what the skipped SSM_CONV+SILU and CPY would have written
+    ctx->unsynced_nodes_written.push_back(silu);
+    ctx->unsynced_nodes_written.push_back(cpy);
+    ctx->skip_nodes.push_back(conv);
+    ctx->skip_nodes.push_back(silu);
+    ctx->skip_nodes.push_back(cpy);
+}
