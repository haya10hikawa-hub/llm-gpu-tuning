diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/conv_step.comp b/ggml/src/ggml-vulkan/vulkan-shaders/conv_step.comp
new file mode 100644
index 0000000..3cb0fa0
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/conv_step.comp
@@ -0,0 +1,44 @@
+#version 450
+
+// Decode step of the gated-delta-net short convolution (kernel 4, one token): the CONCAT(conv state, x^T) ->
+// SSM_CONV -> SILU chain plus the CPY that writes the shifted window back over the conv state, in one dispatch.
+// One invocation per channel reads its 3-value window and the new input, writes silu(dot(window, w)) (the same
+// arithmetic as ssm_conv.comp with APPLY_SILU) and shifts the window in place.
+
+layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+layout(push_constant) uniform parameter
+{
+    uint C;
+    uint st_off;    // element offsets / strides
+    uint x_off;
+    uint x_stride;
+    uint w_off;
+    uint w_stride;
+    uint d_off;
+};
+
+layout(binding = 0, std430) buffer St { float data_st[]; };
+layout(binding = 1, std430) readonly buffer X { float data_x[]; };
+layout(binding = 2, std430) readonly buffer W { float data_w[]; };
+layout(binding = 3, std430) writeonly buffer D { float data_d[]; };
+
+void main() {
+    const uint c = gl_GlobalInvocationID.x;
+    if (c >= C) {
+        return;
+    }
+    const uint s = st_off + 3 * c;
+    const float s0 = data_st[s];
+    const float s1 = data_st[s + 1];
+    const float s2 = data_st[s + 2];
+    const float x = data_x[x_off + c * x_stride];
+    const uint wb = w_off + c * w_stride;
+
+    const float sum = dot(vec4(s0, s1, s2, x), vec4(data_w[wb], data_w[wb + 1], data_w[wb + 2], data_w[wb + 3]));
+    data_d[d_off + c] = sum / (1.0f + exp(-sum));
+
+    data_st[s] = s1;
+    data_st[s + 1] = s2;
+    data_st[s + 2] = x;
+}
