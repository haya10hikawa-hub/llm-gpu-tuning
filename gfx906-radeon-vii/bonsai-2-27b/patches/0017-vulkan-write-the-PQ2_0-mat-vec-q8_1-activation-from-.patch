diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/fwht_q8.glsl b/ggml/src/ggml-vulkan/vulkan-shaders/fwht_q8.glsl
new file mode 100644
index 0000000..fd60382
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/fwht_q8.glsl
@@ -0,0 +1,27 @@
+// q8_1 copy of an FWHT output for the PQ2_0 mat-vec that reads it, in the layout quantize_q8_1_x4_i4 writes:
+// block_q8_1_x4 = f16vec2 ds[4] (d, d * sum) followed by 32 dwords, and within each 16-value half of a 32-value
+// block, dword m holds values m, m+4, m+8, m+12. The same arithmetic as quantize_q8_1.comp, so the bytes match.
+// The 32 values of a q8_1 block must sit in 32 consecutive lanes (element e = base + tid + 256 * i).
+// Needs FWHT_Q8_BINDING and the 8/16-bit storage, int8/float16 arithmetic and clustered subgroup extensions.
+
+layout(binding = FWHT_Q8_BINDING, std430) writeonly buffer Q8 { int8_t data_q8[]; };
+layout(binding = FWHT_Q8_BINDING, std430) writeonly buffer Q8DS { f16vec2 data_q8ds[]; };
+
+void fwht_store_q8(const uint e, const float v) {
+    const float amax = subgroupClusteredMax(abs(v), 32);
+    const float d = amax / 127.0;
+    const float d_inv = d != 0.0 ? 1.0 / d : 0.0;
+    const float q = round(v * d_inv);
+    const float qsum = subgroupClusteredAdd(q, 32);
+
+    const uint b = e / 32;
+    const uint w = e % 32;
+    const uint x4 = b / 4;
+    const uint inner = b % 4;
+    const uint j = w % 16;
+    // 144 bytes per x4 block: 16 bytes of ds, then qs dword (inner * 8 + half * 4 + j % 4), byte j / 4
+    data_q8[x4 * 144 + 16 + (inner * 8 + (w / 16) * 4 + (j % 4)) * 4 + j / 4] = int8_t(q);
+    if (w == 0) {
+        data_q8ds[x4 * 36 + inner] = f16vec2(vec2(d, qsum * d));
+    }
+}
