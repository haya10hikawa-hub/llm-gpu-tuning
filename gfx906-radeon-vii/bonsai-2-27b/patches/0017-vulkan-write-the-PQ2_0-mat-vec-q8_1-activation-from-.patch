+// A rotated activation that feeds a PQ2_0 MMVQ mat-vec gets quantized to q8_1 (quantize_q8_1_x4_i4) by that mat-vec,
+// in its own dispatch plus a barrier. The fused FWHT kernels can write the q8_1 copy into prealloc_y themselves and
+// mark the prealloc_y cache so the mat-vecs skip it. Returns the bytes to write, or 0 when no such mat-vec reads
+// `out` soon.
+static uint64_t ggml_vk_fwht_q8_size(const ggml_backend_vk_context * ctx, const struct ggml_cgraph * cgraph, int node_idx,
+                                     const ggml_tensor * out) {
+    static const bool disabled = getenv("GGML_VK_DISABLE_FWHT_Q8") != nullptr;
+    if (disabled || !ctx->device->integer_dot_product || ctx->device->pipeline_quantize_q8_1_x4_i4 == nullptr ||
+        out->type != GGML_TYPE_F32 || !ggml_is_contiguous(out) || ggml_nelements(out) % 128 != 0) {
+        return 0;
+    }
+    bool consumer = false;
+    for (int j = node_idx + 1; j < cgraph->n_nodes && j <= node_idx + 32 && !consumer; j++) {
+        const ggml_tensor * mm = cgraph->nodes[j];
+        if (mm->op != GGML_OP_MUL_MAT || mm->src[0]->type != GGML_TYPE_PQ2_0) {
+            continue;
+        }
+        const ggml_tensor * y = mm->src[1];
+        if (y != out && !(y->view_src == out && y->view_offs == 0 && ggml_nbytes(y) == ggml_nbytes(out))) {
+            continue;
+        }
+        consumer = y->type == GGML_TYPE_F32 && ggml_is_contiguous(y) && y->ne[2] * y->ne[3] == 1 &&
+                   y->ne[1] <= (int64_t)mul_mat_vec_max_cols &&
+                   ggml_vk_should_use_mmvq(ctx->device, mm->src[0]->ne[1], y->ne[1], y->ne[0], GGML_TYPE_PQ2_0);
+    }
+    return consumer ? (uint64_t)ggml_nelements(out) / 32 * ggml_type_size(GGML_TYPE_Q8_1) : 0;
+}
+
+// grow prealloc_y for the q8_1 copy, as the mat-vec would (flushes the pending work if it has to reallocate)
+static void ggml_vk_fwht_q8_reserve(ggml_backend_vk_context * ctx, vk_context& subctx, uint64_t q8_sz) {
+    if (ctx->prealloc_y == nullptr || ctx->prealloc_y->size < q8_sz) {
+        ctx->prealloc_size_y = std::max<size_t>(ctx->prealloc_size_y, q8_sz);
+        ggml_vk_preallocate_buffers(ctx, subctx);
+    }
+}
+
+// prealloc_y now holds the q8_1_x4_i4 copy of `out`, written by an FWHT kernel
+static void ggml_vk_fwht_q8_mark(ggml_backend_vk_context * ctx, const ggml_tensor * out) {
+    ctx->prealloc_y_last_pipeline_used = ctx->device->pipeline_quantize_q8_1_x4_i4.get();
+    ctx->prealloc_y_last_tensor_used = out;
+    ctx->prealloc_y_last_decode_vector_staging = false;
+    ctx->prealloc_y_need_sync = true;
+}
