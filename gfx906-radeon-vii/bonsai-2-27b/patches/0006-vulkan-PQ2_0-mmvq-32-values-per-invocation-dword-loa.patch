From 86a426211b3b57c1fa92c99a013a3b0a12d8e0f2 Mon Sep 17 00:00:00 2001
From: bench <bench@local>
Date: Fri, 25 Sep 2026 04:02:58 +0000
Subject: [PATCH 06/36] vulkan: PQ2_0 mmvq: 32 values per invocation, dword
 loads with 16-bit funnel shift

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../vulkan-shaders/mul_mat_vecq.comp          |  5 ++-
 .../vulkan-shaders/mul_mat_vecq_funcs.glsl    | 34 ++++++++++++++++++-
 2 files changed, 37 insertions(+), 2 deletions(-)

diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vecq.comp b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vecq.comp
index 39774f2..9733fbd 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vecq.comp
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vecq.comp
@@ -11,7 +11,10 @@
 
 layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;
 
-#if defined(DATA_A_Q2_0) || defined(DATA_A_PQ2_0) || defined(DATA_A_QUANT_K)
+#if defined(DATA_A_PQ2_0)
+// whole 32-value q8_1 sub-block per invocation, see mmvq_dot_product in mul_mat_vecq_funcs.glsl
+#define K_PER_ITER 32
+#elif defined(DATA_A_Q2_0) || defined(DATA_A_QUANT_K)
 #define K_PER_ITER 16
 #elif defined(DATA_A_QUANT_LEGACY) || defined(DATA_A_MXFP4)
 #define K_PER_ITER 8
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vecq_funcs.glsl b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vecq_funcs.glsl
index 8b13224..ad53356 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vecq_funcs.glsl
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vecq_funcs.glsl
@@ -182,7 +182,39 @@ FLOAT_TYPE mul_q8_1(const int32_t q_sum, const float da, const vec2 dsb, const i
 }
 #endif
 
-#if defined(DATA_A_Q2_0) || defined(DATA_A_PQ2_0)
+#if defined(DATA_A_PQ2_0)
+// same buffer as data_a, viewed as dwords so the 2-byte aligned blocks can be read with dword loads
+layout (binding = 0) readonly buffer A_U32 {uint data_a_u32[];};
+
+FLOAT_TYPE mmvq_dot_product(const uint ib_a, const uint iqs) {
+    // ib_a counts 32-value sub-blocks; 4 of them share one 34-byte block {fp16 d, 32 qs bytes}
+    const uint blk = ib_a >> 2u;
+    const uint byte0 = blk * 34u + 2u + (ib_a & 3u) * 8u;
+    const uint w = byte0 >> 2u;
+    const uint w0 = data_a_u32[w];
+    const uint w1 = data_a_u32[w + 1u];
+    uint q0 = w0;
+    uint q1 = w1;
+    if ((byte0 & 2u) != 0u) {
+        const uint w2 = data_a_u32[w + 2u];
+        q0 = (w0 >> 16u) | (w1 << 16u);
+        q1 = (w1 >> 16u) | (w2 << 16u);
+    }
+
+    int32_t q_sum = 0;
+    q_sum += dotPacked4x8EXT(int32_t(unpack_pq2_0(q0)),        cache_b_qs[0]);
+    q_sum += dotPacked4x8EXT(int32_t(unpack_pq2_0(q0 >> 8u)),  cache_b_qs[1]);
+    q_sum += dotPacked4x8EXT(int32_t(unpack_pq2_0(q0 >> 16u)), cache_b_qs[2]);
+    q_sum += dotPacked4x8EXT(int32_t(unpack_pq2_0(q0 >> 24u)), cache_b_qs[3]);
+    q_sum += dotPacked4x8EXT(int32_t(unpack_pq2_0(q1)),        cache_b_qs[4]);
+    q_sum += dotPacked4x8EXT(int32_t(unpack_pq2_0(q1 >> 8u)),  cache_b_qs[5]);
+    q_sum += dotPacked4x8EXT(int32_t(unpack_pq2_0(q1 >> 16u)), cache_b_qs[6]);
+    q_sum += dotPacked4x8EXT(int32_t(unpack_pq2_0(q1 >> 24u)), cache_b_qs[7]);
+
+    // all 32 quants of the q8_1 block => no divisor on its sum term
+    return mul_q8_1(q_sum, get_dm(ib_a), cache_b_ds, 1);
+}
+#elif defined(DATA_A_Q2_0)
 FLOAT_TYPE mmvq_dot_product(const uint ib_a, const uint iqs) {
     int32_t q_sum = 0;
     const i32vec4 qs_a = repack4(ib_a, iqs);
-- 
