+// dim-0 CONCAT(A, B) where B is transposed (dim 1 contiguous): the tiled concat_t shader
+static bool ggml_vk_concat_t_ok(const ggml_backend_vk_context * ctx, const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * dst) {
+    static const bool disabled = getenv("GGML_VK_DISABLE_CONCAT_T") != nullptr;
+    const size_t ts = ggml_type_size(dst->type);
+    return !disabled && ctx->device->pipeline_concat_t_u32 != nullptr && ggml_get_op_params_i32(dst, 0) == 0 && ts == 4 &&
+           src0->type == dst->type && src1->type == dst->type && src1->ne[0] >= 32 && src0->ne[0] <= 32 &&
+           src0->nb[0] == ts && src1->nb[1] == ts && src1->nb[0] % ts == 0 && src0->nb[1] % ts == 0 && src0->nb[2] % ts == 0 &&
+           src1->nb[2] % ts == 0 && ggml_is_contiguous(dst) && src0->ne[3] == 1 && src1->ne[3] == 1 &&
+           src0->ne[1] == src1->ne[1] && src0->ne[2] == src1->ne[2];
+}
+
+static void ggml_vk_concat_t(ggml_backend_vk_context * ctx, vk_context& subctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst) {
+    vk_pipeline pipeline = ctx->device->pipeline_concat_t_u32;
+    ggml_pipeline_request_descriptor_sets(ctx, pipeline, 1);
+    const uint32_t ts = (uint32_t)ggml_type_size(dst->type);
+    const uint32_t T = (uint32_t)src1->ne[0], C = (uint32_t)src1->ne[1], S = (uint32_t)src1->ne[2];
+    const vk_op_concat_t_push_constants pc = {
+        (uint32_t)src0->ne[0], T, C,
+        (uint32_t)(get_misalign_bytes(ctx, src0) / ts), (uint32_t)(src0->nb[1] / ts), (uint32_t)(src0->nb[2] / ts),
+        (uint32_t)(get_misalign_bytes(ctx, src1) / ts), (uint32_t)(src1->nb[0] / ts), (uint32_t)(src1->nb[2] / ts),
+        (uint32_t)(get_misalign_bytes(ctx, dst) / ts), (uint32_t)(dst->nb[1] / ts), (uint32_t)(dst->nb[2] / ts),
+    };
+    ggml_vk_dispatch_pipeline(ctx, subctx, pipeline,
+        { ggml_vk_tensor_subbuffer(ctx, src0, true), ggml_vk_tensor_subbuffer(ctx, src1, true), ggml_vk_tensor_subbuffer(ctx, dst, true) },
+        pc, { CEIL_DIV(T, 32) * 32, CEIL_DIV(C, 32) * 32, S });
+}
+
 static void ggml_vk_concat(ggml_backend_vk_context * ctx, vk_context& subctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst) {
+    if (ggml_vk_concat_t_ok(ctx, src0, src1, dst)) {
+        ggml_vk_concat_t(ctx, subctx, src0, src1, dst);
+        return;
+    }
     int * op_params = (int *)dst->op_params;
 
     const uint32_t unit_size = ggml_vk_concat_unit_size(dst->type);
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/concat_t.comp b/ggml/src/ggml-vulkan/vulkan-shaders/concat_t.comp
new file mode 100644
index 0000000..f4e1da4
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/concat_t.comp
@@ -0,0 +1,64 @@
+#version 450
+
+#extension GL_EXT_control_flow_attributes : require
+
+// CONCAT along dim 0 of a contiguous A [ne00, C, S] and a transposed B [T, C, S] (B's dim 1 is the contiguous
+// one): the gated-delta-net conv input CONCAT(conv_state, qkv^T) at prefill. The generic concat reads B with a
+// stride of C elements per output element; here each 32x32 (t, c) tile goes through shared memory so both the
+// B reads (along c) and the D writes (along t) are contiguous. Workgroups with tile_t == 0 also copy A.
+
+layout(local_size_x = 32, local_size_y = 8, local_size_z = 1) in;
+
+layout(push_constant) uniform parameter
+{
+    uint ne00;   // A dim 0 (conv window), D dim 0 = ne00 + T
+    uint T;
+    uint C;
+    uint a_off;
+    uint a_nb1;  // element strides
+    uint a_nb2;
+    uint b_off;
+    uint b_nb0;
+    uint b_nb2;
+    uint d_off;
+    uint d_nb1;
+    uint d_nb2;
+};
+
+layout(binding = 0, std430) readonly buffer A { uint data_a[]; };
+layout(binding = 1, std430) readonly buffer B { uint data_b[]; };
+layout(binding = 2, std430) writeonly buffer D { uint data_d[]; };
+
+shared uint tile[32][33];
+
+void main() {
+    const uint tx = gl_LocalInvocationID.x;
+    const uint ty = gl_LocalInvocationID.y;
+    const uint t0 = gl_WorkGroupID.x * 32;
+    const uint c0 = gl_WorkGroupID.y * 32;
+    const uint s = gl_WorkGroupID.z;
+
+    // read B[t0 + r, c0 + tx]: contiguous along c
+    [[unroll]] for (uint r = ty; r < 32; r += 8) {
+        const uint t = t0 + r, c = c0 + tx;
+        if (t < T && c < C) {
+            tile[r][tx] = data_b[b_off + s * b_nb2 + t * b_nb0 + c];
+        }
+    }
+    barrier();
+    // write D[ne00 + t0 + tx, c0 + r]: contiguous along t
+    [[unroll]] for (uint r = ty; r < 32; r += 8) {
+        const uint t = t0 + tx, c = c0 + r;
+        if (t < T && c < C) {
+            data_d[d_off + s * d_nb2 + c * d_nb1 + ne00 + t] = tile[tx][r];
+        }
+    }
+    if (gl_WorkGroupID.x == 0) {
+        [[unroll]] for (uint r = ty; r < 32; r += 8) {
+            const uint c = c0 + r;
+            if (tx < ne00 && c < C) {
+                data_d[d_off + s * d_nb2 + c * d_nb1 + tx] = data_a[a_off + s * a_nb2 + c * a_nb1 + tx];
+            }
+        }
+    }
+}
