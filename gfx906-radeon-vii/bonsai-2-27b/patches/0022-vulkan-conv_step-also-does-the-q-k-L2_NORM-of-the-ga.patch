+                                        silu_out->nb[1], 0);
+        l2_out = ggml_l2_norm(ctx, qk, 1e-6f);
+        ggml_tensor * out = ggml_add(ctx, ggml_add(ctx, ggml_sum(ctx, silu_out), ggml_sum(ctx, cache_out)), ggml_sum(ctx, l2_out));
         ggml_set_name(out, "out");
         return out;
     }
@@ -9536,7 +9542,7 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_eval() {
         test_cases.emplace_back(new test_gdn_inplace(nt));
     }
     test_cases.emplace_back(new test_conv_step(10240));
-    test_cases.emplace_back(new test_conv_step(100));
+    test_cases.emplace_back(new test_conv_step(384));
     for (bool mmvq : {false, true}) {
         for (int64_t nt : {1, 3}) {
             test_cases.emplace_back(new test_glu_fwht(17408, nt, mmvq));
