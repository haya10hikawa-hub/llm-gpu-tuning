@@ -6062,7 +6065,7 @@ static void ggml_vk_load_shaders(vk_device& device, vk_pipeline requested) {
 
     ggml_vk_create_pipeline(device, device->pipeline_ssm_conv_f32,           "ssm_conv_f32",           ssm_conv_f32_len, ssm_conv_f32_data, "main", 4, sizeof(vk_op_ssm_conv_push_constants), {32, 16, 1}, {32, 16, 0, 0}, 1);
     ggml_vk_create_pipeline(device, device->pipeline_ssm_conv_silu_f32,      "ssm_conv_silu_f32",      ssm_conv_f32_len, ssm_conv_f32_data, "main", 4, sizeof(vk_op_ssm_conv_push_constants), {32, 16, 1}, {32, 16, 0, 1}, 1);
-    ggml_vk_create_pipeline(device, device->pipeline_conv_step_f32, "conv_step_f32", conv_step_f32_len, conv_step_f32_data, "main", 4, sizeof(vk_op_conv_step_push_constants), {256, 1, 1}, {}, 1);
+    ggml_vk_create_pipeline(device, device->pipeline_conv_step_f32, "conv_step_f32", conv_step_f32_len, conv_step_f32_data, "main", 5, sizeof(vk_op_conv_step_push_constants), {128, 1, 1}, {}, 1);
     ggml_vk_create_pipeline(device, device->pipeline_ssm_conv_bias_silu_f32, "ssm_conv_bias_silu_f32", ssm_conv_f32_len, ssm_conv_f32_data, "main", 4, sizeof(vk_op_ssm_conv_push_constants), {32, 16, 1}, {32, 16, 1, 1}, 1);
 
     ggml_vk_create_pipeline(device, device->pipeline_opt_step_adamw_f32, "opt_step_adamw_f32", opt_step_adamw_f32_len, opt_step_adamw_f32_data, "main", 5, sizeof(vk_op_push_constants), {512, 1, 1}, {}, 1);
@@ -13454,11 +13457,33 @@ static void ggml_vk_ssm_scan(ggml_backend_vk_context * ctx, vk_context& subctx,
 // Decode conv step: CONCAT(st = conv state, x^T) at node_idx, SSM_CONV(cat, w) + SILU, and CPY(view(cat, 1..3) ->
 // st memory). When st is only read by the CONCAT, the concat only feeds those two and real work follows, returns
 // true with the SSM_CONV, SILU and CPY nodes.
+// The L2_NORM over a [128, heads] view at offset 0 of the SILU output (q and k), if one follows: conv_step does it.
+static const ggml_tensor * ggml_vk_conv_step_l2(const struct ggml_cgraph * cgraph, int node_idx, const ggml_tensor * silu) {
+    static const bool disabled = getenv("GGML_VK_DISABLE_CONV_L2") != nullptr;
+    if (disabled) {
+        return nullptr;
+    }
+    for (int j = node_idx + 1; j < cgraph->n_nodes && j <= node_idx + 48; j++) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (n->op != GGML_OP_L2_NORM) {
+            continue;
+        }
+        const ggml_tensor * v = n->src[0];
+        if (v->view_src != silu || v->view_offs != 0 || v->type != GGML_TYPE_F32 || n->type != GGML_TYPE_F32 ||
+            v->ne[0] != 128 || v->ne[2] != 1 || v->ne[3] != 1 || v->nb[0] != sizeof(float) || v->nb[1] != 128 * sizeof(float) ||
+            !ggml_is_contiguous(n) || v->ne[1] * 128 > silu->ne[0] || !ggml_vk_has_later_work(cgraph, j)) {
+            return nullptr;
+        }
+        return n;
+    }
+    return nullptr;
+}
+
 static bool ggml_vk_can_conv_step(const ggml_backend_vk_context * ctx, const struct ggml_cgraph * cgraph, int node_idx,
                                   const ggml_tensor ** conv, const ggml_tensor ** silu, const ggml_tensor ** cpy) {
     static const bool disabled = getenv("GGML_VK_DISABLE_CONV_STEP") != nullptr;
     const ggml_tensor * cat = cgraph->nodes[node_idx];
-    if (disabled || ctx->device->pipeline_conv_step_f32 == nullptr || cat->op != GGML_OP_CONCAT ||
+    if (disabled || ctx->device->pipeline_conv_step_f32 == nullptr || !ctx->device->subgroup_arithmetic || cat->op != GGML_OP_CONCAT ||
         ggml_get_op_params_i32(cat, 0) != 0) {
         return false;
     }
@@ -13509,7 +13534,8 @@ static bool ggml_vk_can_conv_step(const ggml_backend_vk_context * ctx, const str
 }
 
 static void ggml_vk_conv_step(ggml_backend_vk_context * ctx, vk_context& subctx, const ggml_tensor * cat,
-                              const ggml_tensor * conv, const ggml_tensor * silu, const ggml_tensor * cpy) {
+                              const ggml_tensor * conv, const ggml_tensor * silu, const ggml_tensor * cpy,
+                              const ggml_tensor * l2) {
     const ggml_tensor * st = cat->src[0];
     const ggml_tensor * x = cat->src[1];
     const ggml_tensor * w = conv->src[1];
@@ -13523,11 +13549,19 @@ static void ggml_vk_conv_step(ggml_backend_vk_context * ctx, vk_context& subctx,
         (uint32_t)(get_misalign_bytes(ctx, x) / sizeof(float)), (uint32_t)(x->nb[1] / sizeof(float)),
         (uint32_t)(get_misalign_bytes(ctx, w) / sizeof(float)), (uint32_t)(w->nb[1] / sizeof(float)),
         (uint32_t)(get_misalign_bytes(ctx, silu) / sizeof(float)),
+        l2 ? (uint32_t)l2->src[0]->ne[1] : 0u,
+        l2 ? (uint32_t)(get_misalign_bytes(ctx, l2) / sizeof(float)) : 0u,
+        l2 ? ggml_get_op_params_f32(l2, 0) : 0.0f,
     };
+    const vk_subbuffer d_buf = ggml_vk_tensor_subbuffer(ctx, silu, true);
     ggml_vk_dispatch_pipeline(ctx, subctx, pipeline,
         { ggml_vk_tensor_subbuffer(ctx, st, true), ggml_vk_tensor_subbuffer(ctx, x, true),
-          ggml_vk_tensor_subbuffer(ctx, w, true), ggml_vk_tensor_subbuffer(ctx, silu, true) },
+          ggml_vk_tensor_subbuffer(ctx, w, true), d_buf, l2 ? ggml_vk_tensor_subbuffer(ctx, l2, true) : d_buf },
         pc, { C, 1, 1 });
+    if (l2) {
+        ctx->unsynced_nodes_written.push_back(l2);
+        ctx->skip_nodes.push_back(l2);
+    }
 
     // what the skipped SSM_CONV+SILU and CPY would have written
     ctx->unsynced_nodes_written.push_back(silu);
@@ -16168,7 +16202,8 @@ static bool ggml_vk_build_graph(ggml_backend_vk_context * ctx, ggml_cgraph * cgr
         {
             const ggml_tensor * conv, * silu, * cpy;
             if (ggml_vk_can_conv_step(ctx, cgraph, node_idx, &conv, &silu, &cpy)) {
-                ggml_vk_conv_step(ctx, compute_ctx, node, conv, silu, cpy);
+                ggml_vk_conv_step(ctx, compute_ctx, node, conv, silu, cpy,
+                                  ggml_vk_conv_step_l2(cgraph, node_idx, silu));
                 break;
             }
         }
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/conv_step.comp b/ggml/src/ggml-vulkan/vulkan-shaders/conv_step.comp
index 3cb0fa0..664c59e 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/conv_step.comp
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/conv_step.comp
@@ -4,8 +4,15 @@
 // SSM_CONV -> SILU chain plus the CPY that writes the shifted window back over the conv state, in one dispatch.
 // One invocation per channel reads its 3-value window and the new input, writes silu(dot(window, w)) (the same
 // arithmetic as ssm_conv.comp with APPLY_SILU) and shifts the window in place.
+// With l2_heads > 0 the first l2_heads 128-channel heads (q and k) are also L2-normalised per head, as the
+// L2_NORM that follows would (x / max(|x|, eps)), and written to the L2 output: one workgroup is one head.
 
-layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+#extension GL_KHR_shader_subgroup_basic : require
+#extension GL_KHR_shader_subgroup_arithmetic : require
+
+#define WG 128
+
+layout(local_size_x = WG, local_size_y = 1, local_size_z = 1) in;
 
 layout(push_constant) uniform parameter
 {
@@ -16,29 +23,49 @@ layout(push_constant) uniform parameter
     uint w_off;
     uint w_stride;
     uint d_off;
+    uint l2_heads;
+    uint l2_off;
+    float eps;
 };
 
 layout(binding = 0, std430) buffer St { float data_st[]; };
 layout(binding = 1, std430) readonly buffer X { float data_x[]; };
 layout(binding = 2, std430) readonly buffer W { float data_w[]; };
 layout(binding = 3, std430) writeonly buffer D { float data_d[]; };
+layout(binding = 4, std430) writeonly buffer L2 { float data_l2[]; };
+
+shared float red[WG / 32];
 
 void main() {
     const uint c = gl_GlobalInvocationID.x;
-    if (c >= C) {
-        return;
+    float y = 0.0;
+    if (c < C) {
+        const uint s = st_off + 3 * c;
+        const float s0 = data_st[s];
+        const float s1 = data_st[s + 1];
+        const float s2 = data_st[s + 2];
+        const float x = data_x[x_off + c * x_stride];
+        const uint wb = w_off + c * w_stride;
+
+        const float sum = dot(vec4(s0, s1, s2, x), vec4(data_w[wb], data_w[wb + 1], data_w[wb + 2], data_w[wb + 3]));
+        y = sum / (1.0f + exp(-sum));
+        data_d[d_off + c] = y;
+
+        data_st[s] = s1;
+        data_st[s + 1] = s2;
+        data_st[s + 2] = x;
+    }
+
+    if (gl_WorkGroupID.x < l2_heads) {   // uniform per workgroup
+        const float ss = subgroupAdd(y * y);
+        if (gl_SubgroupInvocationID == 0) {
+            red[gl_SubgroupID] = ss;
+        }
+        barrier();
+        float total = 0.0;
+        for (uint i = 0; i < gl_NumSubgroups; ++i) {
+            total += red[i];
+        }
+        data_l2[l2_off + c] = y / max(sqrt(total), eps);
     }
-    const uint s = st_off + 3 * c;
-    const float s0 = data_st[s];
-    const float s1 = data_st[s + 1];
-    const float s2 = data_st[s + 2];
-    const float x = data_x[x_off + c * x_stride];
-    const uint wb = w_off + c * w_stride;
-
-    const float sum = dot(vec4(s0, s1, s2, x), vec4(data_w[wb], data_w[wb + 1], data_w[wb + 2], data_w[wb + 3]));
-    data_d[d_off + c] = sum / (1.0f + exp(-sum));
-
-    data_st[s] = s1;
-    data_st[s + 1] = s2;
-    data_st[s + 2] = x;
 }
