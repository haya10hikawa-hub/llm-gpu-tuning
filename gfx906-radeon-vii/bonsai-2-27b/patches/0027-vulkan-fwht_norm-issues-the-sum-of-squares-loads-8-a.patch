From d835127c1bd5165952d4e4f149d3272026a3bf66 Mon Sep 17 00:00:00 2001
From: bench <bench@local>
Date: Sat, 26 Sep 2026 06:36:27 +0000
Subject: [PATCH 27/34] vulkan: fwht_norm issues the sum-of-squares loads 8 at
 a time (latency-bound row walk)

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 ggml/src/ggml-vulkan/vulkan-shaders/fwht_norm.comp | 13 ++++++++++---
 1 file changed, 10 insertions(+), 3 deletions(-)

diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/fwht_norm.comp b/ggml/src/ggml-vulkan/vulkan-shaders/fwht_norm.comp
index 0b90a3c..fbae726 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/fwht_norm.comp
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/fwht_norm.comp
@@ -67,10 +67,17 @@ void main() {
         const uint blk = wgi % blocks;
         const uint xrow = x_off + row * x_row_stride;
 
+        // 8 independent loads per iteration: few workgroups run, so the row walk is latency-bound
         float ss = 0.0;
-        for (uint e = tid; e < row_width; e += WG) {
-            const float v = data_x[xrow + e];
-            ss += v * v;
+        for (uint e0 = tid; e0 < row_width; e0 += 8 * WG) {
+            float v[8];
+            [[unroll]] for (uint j = 0; j < 8; ++j) {
+                const uint e = e0 + j * WG;
+                v[j] = e < row_width ? data_x[xrow + e] : 0.0;
+            }
+            [[unroll]] for (uint j = 0; j < 8; ++j) {
+                ss += v[j] * v[j];
+            }
         }
         ss = subgroupAdd(ss);
         if (gl_SubgroupInvocationID == 0) {
-- 
