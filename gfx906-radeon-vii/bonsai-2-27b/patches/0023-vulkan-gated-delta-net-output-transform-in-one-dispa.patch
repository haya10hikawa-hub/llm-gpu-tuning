diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/fwht_gdn_tail.comp b/ggml/src/ggml-vulkan/vulkan-shaders/fwht_gdn_tail.comp
new file mode 100644
index 0000000..b08f3af
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/fwht_gdn_tail.comp
@@ -0,0 +1,146 @@
+#version 450
+
+// The output transform of a gated-delta-net layer in one dispatch, in front of the Hadamard-folded ssm_out:
+//   RMS_NORM per head (hd values) * w  ->  swiglu(z, .)  ->  tiled [hd, nk, rep] to grouped [hd, rep, nk] head order
+//   (CONT of a permute)  ->  * signs  ->  FWHT over N-blocks
+// One workgroup per (token, N-block of the permuted row). The block holds N / hd whole heads, so each workgroup
+// computes the norms of its own heads. With FWHT_Q8 the q8_1 copy for the PQ2_0 mat-vec is written too.
+
+#extension GL_EXT_control_flow_attributes : require
+#extension GL_KHR_shader_subgroup_basic : require
+#extension GL_KHR_shader_subgroup_arithmetic : require
+#extension GL_KHR_shader_subgroup_shuffle : require
+#ifdef FWHT_Q8
+#extension GL_EXT_shader_8bit_storage : require
+#extension GL_EXT_shader_16bit_storage : require
+#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
+#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
+#extension GL_KHR_shader_subgroup_clustered : require
+#endif
+
+layout(constant_id = 0) const uint N = 1024;
+
+#define WG 256
+#define HD 128
+const uint EL = N / WG;
+
+layout(local_size_x = WG, local_size_y = 1, local_size_z = 1) in;
+
+layout(push_constant) uniform parameter
+{
+    uint n_blocks;       // tokens * blocks_per_tok
+    uint blocks_per_tok; // row width / N
+    uint nk;             // head groups in the tiled order
+    uint rep;
+    uint x_off;
+    uint x_tok;          // elements per token of x and z
+    uint z_off;
+    uint w_off;
+    uint sign_off;
+    uint dst_off;
+    float eps;
+    float scale;         // 1/sqrt(N)
+};
+
+layout(binding = 0, std430) readonly buffer X { float data_x[]; };
+layout(binding = 1, std430) readonly buffer Z { float data_z[]; };
+layout(binding = 2, std430) readonly buffer Wt { float data_w[]; };
+layout(binding = 3, std430) readonly buffer S { float data_s[]; };
+layout(binding = 4, std430) writeonly buffer D { float data_d[]; };
+#ifdef FWHT_Q8
+#define FWHT_Q8_BINDING 5
+#include "fwht_q8.glsl"
+#endif
+
+shared float shmem[N];
+shared float red[EL][WG / 32];
+
+void main() {
+    const uint tid = gl_LocalInvocationID.x;
+    const uint sg = gl_SubgroupSize;
+
+    for (uint wgi = gl_WorkGroupID.x; wgi < n_blocks; wgi += gl_NumWorkGroups.x) {
+        const uint tok = wgi / blocks_per_tok;
+        const uint blk = wgi % blocks_per_tok;
+
+        // gather: output feature f = blk * N + e sits in grouped head slot g = f / HD = r + rep * k,
+        // which reads source head h = k + nk * r
+        float xv[EL];
+        float zv[EL];
+        uint hdi[EL];
+        [[unroll]] for (uint i = 0; i < EL; ++i) {
+            const uint f = blk * N + tid + WG * i;
+            const uint g = f / HD;
+            const uint h = (g / rep) + nk * (g % rep);
+            hdi[i] = f % HD;
+            const uint src = tok * x_tok + h * HD + hdi[i];
+            xv[i] = data_x[x_off + src];
+            zv[i] = data_z[z_off + src];
+        }
+
+        // per-head sum of squares: for register i, the HD lanes of one head are HD / sg whole subgroups
+        [[unroll]] for (uint i = 0; i < EL; ++i) {
+            const float ss = subgroupAdd(xv[i] * xv[i]);
+            if (gl_SubgroupInvocationID == 0) {
+                red[i][gl_SubgroupID] = ss;
+            }
+        }
+        barrier();
+        const uint sg_per_head = HD / sg;
+        const uint first_sg = (tid / HD) * sg_per_head;
+
+        float reg[EL];
+        [[unroll]] for (uint i = 0; i < EL; ++i) {
+            float total = 0.0;
+            for (uint s = 0; s < sg_per_head; ++s) {
+                total += red[i][first_sg + s];
+            }
+            const float rs = inversesqrt(total / float(HD) + eps);
+            const float xn = xv[i] * rs * data_w[w_off + hdi[i]];
+            const float a = zv[i];
+            reg[i] = a / (1.0f + exp(-a)) * xn * data_s[sign_off + blk * N + tid + WG * i] * scale;
+        }
+        barrier();
+
+        [[unroll]] for (uint h = 1; h < WG; h <<= 1) {
+            const bool upper = (tid & h) != 0;
+            if (h < sg) {
+                [[unroll]] for (uint i = 0; i < EL; ++i) {
+                    const float other = subgroupShuffleXor(reg[i], h);
+                    reg[i] = upper ? other - reg[i] : reg[i] + other;
+                }
+            } else {
+                [[unroll]] for (uint i = 0; i < EL; ++i) {
+                    shmem[tid + WG * i] = reg[i];
+                }
+                barrier();
+                [[unroll]] for (uint i = 0; i < EL; ++i) {
+                    const float other = shmem[(tid ^ h) + WG * i];
+                    reg[i] = upper ? other - reg[i] : reg[i] + other;
+                }
+                barrier();
+            }
+        }
+
+        [[unroll]] for (uint step = 1; step < EL; step <<= 1) {
+            [[unroll]] for (uint i = 0; i < EL; ++i) {
+                if ((i & step) == 0) {
+                    const float x = reg[i];
+                    const float y = reg[i + step];
+                    reg[i] = x + y;
+                    reg[i + step] = x - y;
+                }
+            }
+        }
+
+        [[unroll]] for (uint i = 0; i < EL; ++i) {
+            data_d[dst_off + wgi * N + tid + WG * i] = reg[i];
+        }
+#ifdef FWHT_Q8
+        [[unroll]] for (uint i = 0; i < EL; ++i) {
+            fwht_store_q8(wgi * N + tid + WG * i, reg[i]);
+        }
+#endif
+        barrier();
+    }
+}
