+static bool ggml_vk_has_later_work(const struct ggml_cgraph * cgraph, int node_idx);
+
+struct vk_gdn_tail {
+    const ggml_tensor * mw, * glu, * cont, * ms;
+    ggml_tensor * mm;
+    int mm_idx;
+};
+
+// next node in (node_idx, node_idx + 40] that reads `src` (directly or through views) as source `slot`, or -1
+static int ggml_vk_find_consumer(const struct ggml_cgraph * cgraph, int node_idx, const ggml_tensor * src, ggml_op op, int slot) {
+    for (int j = node_idx + 1; j < cgraph->n_nodes && j <= node_idx + 40; j++) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (n->op != op) {
+            continue;
+        }
+        const ggml_tensor * s = n->src[slot];
+        if (s == src || (s != nullptr && s->view_src == src)) {
+            return j;
+        }
+    }
+    return -1;
+}
+
+// RMS_NORM(x) at node_idx -> MUL(w) -> GLU swiglu(z, .) -> CONT(permute [hd, nk, rep] -> [hd, rep, nk]) -> MUL(signs)
+// -> MUL_MAT(H) (Hadamard hint), every intermediate with one consumer: the gated-delta-net output transform
+static bool ggml_vk_can_gdn_tail(const ggml_backend_vk_context * ctx, const struct ggml_cgraph * cgraph, int node_idx, vk_gdn_tail & t) {
+    static const bool disabled = getenv("GGML_VK_DISABLE_GDN_TAIL") != nullptr;
+    const ggml_tensor * rn = cgraph->nodes[node_idx];
+    if (disabled || rn->op != GGML_OP_RMS_NORM || !ctx->device->subgroup_arithmetic) {
+        return false;
+    }
+    const ggml_tensor * x = rn->src[0];
+    if (x->type != GGML_TYPE_F32 || rn->type != GGML_TYPE_F32 || !ggml_is_contiguous(x) || x->ne[0] != 128 ||
+        ggml_node_get_use_count(cgraph, node_idx) != 1) {
+        return false;
+    }
+    const int i_mw = ggml_vk_find_consumer(cgraph, node_idx, rn, GGML_OP_MUL, 0);
+    if (i_mw < 0) {
+        return false;
+    }
+    const ggml_tensor * mw = cgraph->nodes[i_mw];
+    const ggml_tensor * w = mw->src[1];
+    if (mw->src[0] != rn || w->type != GGML_TYPE_F32 || !ggml_is_contiguous(w) || ggml_nelements(w) != 128 ||
+        ggml_node_get_use_count(cgraph, i_mw) != 1) {
+        return false;
+    }
+    const int i_glu = ggml_vk_find_consumer(cgraph, i_mw, mw, GGML_OP_GLU, 1);
+    if (i_glu < 0) {
+        return false;
+    }
+    const ggml_tensor * glu = cgraph->nodes[i_glu];
+    const ggml_tensor * z = glu->src[0];
+    if (ggml_get_glu_op(glu) != GGML_GLU_OP_SWIGLU || glu->src[1] != mw || z->type != GGML_TYPE_F32 ||
+        !ggml_is_contiguous(z) || !ggml_are_same_shape(z, x) || ggml_node_get_use_count(cgraph, i_glu) != 1) {
+        return false;
+    }
+    const int i_cont = ggml_vk_find_consumer(cgraph, i_glu, glu, GGML_OP_CONT, 0);
+    if (i_cont < 0) {
+        return false;
+    }
+    const ggml_tensor * cont = cgraph->nodes[i_cont];
+    const ggml_tensor * p = cont->src[0];   // permuted view [hd, rep, nk, tokens]
+    const int64_t hd = p->ne[0], rep = p->ne[1], nk = p->ne[2];
+    const size_t fs = sizeof(float);
+    if (p->type != GGML_TYPE_F32 || hd != 128 || p->view_offs != 0 || p->nb[0] != fs || p->nb[1] != (size_t)(hd * nk) * fs ||
+        p->nb[2] != (size_t)hd * fs || p->nb[3] != (size_t)(hd * nk * rep) * fs || hd * nk * rep != x->ne[0] * x->ne[1] ||
+        p->ne[3] != x->ne[2] * x->ne[3] || ggml_node_get_use_count(cgraph, i_cont) != 1) {
+        return false;
+    }
+    const int i_ms = ggml_vk_find_consumer(cgraph, i_cont, cont, GGML_OP_MUL, 0);
+    if (i_ms < 0) {
+        return false;
+    }
+    const ggml_tensor * ms = cgraph->nodes[i_ms];
+    const ggml_tensor * signs = ms->src[1];
+    const int64_t W = hd * nk * rep;
+    if (signs->type != GGML_TYPE_F32 || !ggml_is_contiguous(signs) || ggml_nelements(signs) != W || !ggml_is_contiguous(ms) ||
+        ggml_node_get_use_count(cgraph, i_ms) != 1) {
+        return false;
+    }
+    const int i_mm = ggml_vk_find_consumer(cgraph, i_ms, ms, GGML_OP_MUL_MAT, 1);
+    if (i_mm < 0) {
+        return false;
+    }
+    ggml_tensor * mm = cgraph->nodes[i_mm];
+    if (ggml_get_op_params_i32(mm, 1) != GGML_HINT_SRC0_IS_HADAMARD || mm->type != GGML_TYPE_F32 || !ggml_is_contiguous(mm)) {
+        return false;
+    }
+    const int64_t n = mm->src[0]->ne[0];
+    const int idx = ggml_vk_fwht_pipeline_idx(n);
+    if (idx < 0 || ctx->device->pipeline_fwht_gdn_tail_f32[idx] == nullptr || W % n != 0 || n % hd != 0 ||
+        !ggml_vk_has_later_work(cgraph, i_mm)) {
+        return false;
+    }
+    t = { mw, glu, cont, ms, mm, i_mm };
+    return true;
+}
+
+static void ggml_vk_gdn_tail(ggml_backend_vk_context * ctx, vk_context& subctx, const struct ggml_cgraph * cgraph, int node_idx,
+                             const vk_gdn_tail & t) {
+    const ggml_tensor * rn = cgraph->nodes[node_idx];
+    const ggml_tensor * x = rn->src[0];
+    const ggml_tensor * z = t.glu->src[0];
+    const ggml_tensor * w = t.mw->src[1];
+    const ggml_tensor * signs = t.ms->src[1];
+    const ggml_tensor * p = t.cont->src[0];
+    const int64_t n = t.mm->src[0]->ne[0];
+    const int idx = ggml_vk_fwht_pipeline_idx(n);
+    const int64_t W = ggml_nelements(signs);
+    const uint32_t tokens = (uint32_t)(ggml_nelements(x) / W);
+
+    vk_pipeline pipeline = ctx->device->pipeline_fwht_gdn_tail_f32[idx];
+    uint64_t q8_sz = ctx->device->pipeline_fwht_gdn_tail_q8_f32[idx] != nullptr ? ggml_vk_fwht_q8_size(ctx, cgraph, t.mm_idx, t.mm) : 0;
+    if (q8_sz != 0) {
+        pipeline = ctx->device->pipeline_fwht_gdn_tail_q8_f32[idx];
+        ggml_vk_fwht_q8_reserve(ctx, subctx, q8_sz);
+    }
+    ggml_pipeline_request_descriptor_sets(ctx, pipeline, 1);
+
+    float eps;
+    memcpy(&eps, rn->op_params, sizeof(float));
+    const uint32_t blocks_per_tok = (uint32_t)(W / n);
+    const vk_op_fwht_gdn_tail_push_constants pc = {
+        tokens * blocks_per_tok, blocks_per_tok, (uint32_t)p->ne[2], (uint32_t)p->ne[1],
+        (uint32_t)(get_misalign_bytes(ctx, x) / sizeof(float)), (uint32_t)W,
+        (uint32_t)(get_misalign_bytes(ctx, z) / sizeof(float)),
+        (uint32_t)(get_misalign_bytes(ctx, w) / sizeof(float)),
+        (uint32_t)(get_misalign_bytes(ctx, signs) / sizeof(float)),
+        (uint32_t)(get_misalign_bytes(ctx, t.mm) / sizeof(float)),
+        eps, 1.0f / std::sqrt((float)n),
+    };
+    const uint32_t n_wg = std::min<uint32_t>(tokens * blocks_per_tok, ctx->device->properties.limits.maxComputeWorkGroupCount[0]);
+    const vk_subbuffer x_buf = ggml_vk_tensor_subbuffer(ctx, x, true);
+    const vk_subbuffer z_buf = ggml_vk_tensor_subbuffer(ctx, z, true);
+    const vk_subbuffer w_buf = ggml_vk_tensor_subbuffer(ctx, w, true);
+    const vk_subbuffer s_buf = ggml_vk_tensor_subbuffer(ctx, signs, true);
+    const vk_subbuffer d_buf = ggml_vk_tensor_subbuffer(ctx, t.mm, true);
+    if (q8_sz != 0) {
+        const vk_subbuffer q8_buf = { ctx->prealloc_y, 0, q8_sz };
+        if (ctx->prealloc_y_need_sync) {
+            ggml_vk_sync_buffers(ctx, subctx);
+        }
+        ggml_vk_dispatch_pipeline(ctx, subctx, pipeline, { x_buf, z_buf, w_buf, s_buf, d_buf, q8_buf }, pc, { n_wg, 1, 1 });
+        ggml_vk_fwht_q8_mark(ctx, t.mm);
+    } else {
+        ggml_vk_dispatch_pipeline(ctx, subctx, pipeline, { x_buf, z_buf, w_buf, s_buf, d_buf }, pc, { n_wg, 1, 1 });
+    }
+    ctx->unsynced_nodes_written.push_back(t.mm);
+    for (const ggml_tensor * s : { (const ggml_tensor *)t.mw, t.glu, t.cont, t.ms, (const ggml_tensor *)t.mm }) {
+        ctx->skip_nodes.push_back(s);
+    }
+}
