[Unit]
Description=Local LLM OpenAI-compatible API (Qwen3.8-27B on gfx906)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
# Without these the process cannot open /dev/dri and silently falls back to CPU.
SupplementaryGroups=render video
EnvironmentFile=/etc/llm-api.env
WorkingDirectory=/opt/llm-gpu-tuning
ExecStart=/opt/llm-gpu-tuning/work/llama.cpp/build/bin/llama-server \
  --model /opt/llm-gpu-tuning/gfx906-radeon-vii/qwen3.8-27b/models/Qwen3.8-27B-UD-Q4_K_S.gguf \
  --alias qwen3.8-27b \
  --n-gpu-layers 99 \
  --ctx-size 32768 \
  --parallel 1 \
  --cache-type-k q8_0 --cache-type-v q8_0 \
  --batch-size 512 --ubatch-size 256 \
  --jinja \
  --host 0.0.0.0 --port 8080 \
  --api-key ${LLAMA_API_KEY} \
  --metrics
# always, not on-failure: a clean self-exit must also come back (residency).
Restart=always
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=60
Nice=-5

[Install]
WantedBy=multi-user.target
